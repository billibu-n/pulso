// EL ARMAZON: los sitios de la ventana, y el orden en que se repliegan.
//
// CONTRATO: `docs/ESPECIFICACION-interfaz-resumen.md`, fase 0 CONGELADA (2026-10-14).
// Cada numero de este fichero sale de ahi y lleva su cita `doc:linea` (la linea del documento).
// Regla de uso, literal: **quien construya no dibuja nada que no este en la especificacion**.
//
// LA NORMA QUE CUMPLE, y cada regla con su motivo (norma-app, AU-01 a AU-08):
//
//   AU-01  Al encoger, los sitios pierden EN ESTE ORDEN y el contenido es el ULTIMO:
//          1) el contenido  ·  2) el panel inferior  ·  3) el panel derecho  ·  4) el riel
//   AU-02  El riel, al perder su columna, se vuelve CAJON QUE SE ABRE -- no se oculta.
//          Un boton que no abre nada es PEOR que no tenerlo.
//   AU-03  En ventana estrecha, el cajon NACE CERRADO. Abrirlo por defecto TAPA el contenido.
//   AU-04  El contenido es el UNICO sitio que crece; los demas tienen limite declarado.
//   AU-05  Apilado, el armazon CRECE con su contenido y se desplaza la pagina.
//   AU-06  Todo sitio que se repliega deja forma de volver.
//   AU-07  Un sitio RESERVADO se declara; un hueco olvidado no se dibuja.
//   AU-93  La barra de abajo NO SE MUEVE: el contenido declara su altura MINIMA.
//
// Y HAY DOS REPARTOS, no uno, porque el cliente usa el MOVIL como dispositivo principal:
//   ESCRITORIO (>= 900 px): riel de 176 a la izquierda, panel de 320 a la derecha, franja abajo
//   MOVIL (< 900 px): navegacion ABAJO, sin riel -- porque en 411 dp el riel se comeria el 43 %
//
// LAS AREAS TOCABLES: 48 dp como minimo en el movil. **El dedo no es un raton.**

import { Claro, Oscuro } from "temas.slint";
// LOS ICONOS DE VERDAD. Existian 187 y la barra dibujaba cuadrados: el boceto dibujo un cuadrado
// como marcador y el marcador llego a produccion. Lo cazo el estudio del 2026-10-14.
import { Icono } from "iconos.slint";
// El desplazamiento del contenido es un control DE SERIE (AU-05, doc:190-192): no se reescribe.
import { ScrollView } from "std-widgets.slint";

// ---- Las medidas, declaradas UNA sola vez (AU-67, `slint:186`; doc:34-56) ----
//
// `global Medidas` es la **UNICA** declaracion de medidas del proyecto (AU-67, AU-73): ninguna otra
// pieza escribe un 64, un 80 o un 16. Y `motor/tests/medir-interfaz.rs` las comprueba **contra la
// geometria real**, no contra este comentario.
export global Medidas {
    // ESTAS MEDIDAS NO SE CAMBIAN «para que quede mejor»: cambiarlas mueve la pantalla entera.
    // Se cambiaron una vez a ojo el 2026-10-13 (margen 16 -> 18, nav 64 -> 68) y la pantalla dejo de
    // parecerse al diseno aprobado **sin que nadie se enterara**. Ahora hay quien lo comprueba.

    // EL TAMANO DE LA VENTANA (doc:43, `armazon.slint:36-37`; prueba `medir-interfaz.rs:88-89`).
    // La ventana no se redimensiona: es un telefono de 411 x 880 dp. Un solo sitio.
    out property <length> ancho: 411px;
    out property <length> alto: 880px;
    // El corte entre movil y escritorio, en pixeles logicos.
    out property <length> corte: 900px;
    out property <length> riel: 176px;
    out property <length> panel: 320px;
    // MEDIDAS DE ANDROID (Material 3): top app bar small 64, navigation bar con etiquetas 80.
    // Fuente: docs/ESTUDIO-interfaz-android-2026-10-14.md:24-25 (`estudio:24`, `estudio:25`).
    out property <length> cabecera: 64px;      // doc:44   (antes 56, que era del boceto)
    out property <length> nav_movil: 80px;     // doc:46   (antes 64)
    // Las areas tocables, y son DOS medidas distintas a proposito.
    out property <length> toque_movil: 48px;   // doc:50 el dedo (`minimumInteractiveComponentSize`)
    out property <length> toque_raton: 32px;   // el puntero puede apuntar fino
    out property <length> margen: 16px;        // doc:52 el margen de la pantalla, por los CUATRO lados
    // 12 es el radio de tarjeta de Material 3 (`estudio:28`, doc:51). Antes 10, que era del boceto.
    out property <length> radio: 12px;
    // El hueco entre bloques del contenido: 14 (`armazon.slint:117`, doc:53).
    out property <length> hueco_bloques: 14px;
    // LA ALTURA MINIMA DEL CONTENIDO, declarada y no deducida (AU-93, doc:182):
    //   alto - cabecera - nav = 880 - 64 - 80 = **736**.
    // POR QUE SE DECLARA: al dejar de dibujar los vacios (AU-91) el armazon ENCOGIO y **la barra de
    // abajo subio al centro de la pantalla**. Se cazo midiendo, no mirando (`estado:486-487`).
    // Consecuencia para las fases 2 y 3: **quitar o anadir un bloque NO puede mover la barra**.
    out property <length> alto_contenido: alto - cabecera - nav_movil;
    // EL AIRE DE LA BARRA DE ABAJO (doc:169): 4 px. Son LOS DOS de la misma medida -- el que va
    // entre cada dos huecos y el que queda en los extremos --, y por eso se declara UNA vez: el
    // ancho de cada hueco se DERIVA de aqui (ver el armazon de movil), y asi los dos numeros no
    // pueden divergir.
    //
    // Y el reparto NO lo decide el texto -- eso fue el fallo que se vio en pantalla
    // («ResumenZonasSesionesDatos», todo pegado) y que `medir-interfaz.rs` vigila.
    out property <length> aire_nav: 4px;
}

// ---- Una seccion del riel o de la navegacion ----
export struct Seccion {
    nombre: string,
    // El NOMBRE del icono de Lucide. Es DATO, no decoracion: la seccion dice con que icono se dibuja,
    // y asi el armazon no tiene una lista aparte que se desincronice (AU-10).
    icono: string,
    activa: bool,
}

// ---- EL ARMAZON DE ESCRITORIO ----
//
// POR QUE SON DOS COMPONENTES Y NO UNO CON UN `if`: en Slint, `@children` NO puede aparecer dentro de
// un elemento condicional. Se probo y no compila. Asi que el armazon se parte, y **la condicion va en
// la ventana**, que es quien sabe si es movil o no.
export component ArmazonEscritorio inherits Rectangle {
    in property <bool> oscuro: false;
    in property <[Seccion]> secciones;
    in property <string> titulo;
    callback elegir(int);

    // EL TAMANO DE LA VENTANA, que LO SABE LA VENTANA y se lo pasa (AU-67: el valor vive en un sitio).
    // No se puede pedir con `parent`: dentro de un componente, `parent` no es accesible -- Slint lo dice
    // al compilar, «Cannot access id 'parent'» (probado el 2026-10-14).
    in property <length> ancho_ventana: Medidas.ancho;
    in property <length> alto_ventana: Medidas.alto;

    // EN ESCRITORIO SE OCUPA LA VENTANA, Y ESTABA MAL (medido el 2026-10-14):
    //
    //   - esta rama solo se dibuja cuando la ventana pasa del corte de 900 (doc:130), o sea que NUNCA
    //     mide 411 -- y sin embargo tenia clavados los **411 x 880** del telefono. Medido: en una
    //     ventana de 1280 x 800 el armazon medía **411 x 880 y salia CENTRADO** (x = 434,5), con el
    //     reparto de escritorio (riel de 176 + contenido) dejando el contenido en **235** de ancho y
    //     flotando en medio de la ventana;
    //   - nadie lo habia medido porque `cargo run` abre 411 x 880 (`pulso.rs` solo hace
    //     `Ventana::new()` y `run()`): con ese ancho `es_movil` es cierto SIEMPRE y esta rama no llega
    //     a existir en el uso normal.
    //
    // Lo mide `el_armazon_de_escritorio_ocupa_la_ventana_y_sus_bloques_llevan_el_margen`.
    width: root.ancho_ventana;
    height: root.alto_ventana;
    background: root.oscuro ? Oscuro.bg : Claro.bg;
    HorizontalLayout {
        // --- EL RIEL: limite declarado, no crece (AU-04) ---
        Rectangle {
            width: Medidas.riel;
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            VerticalLayout {
                // ---- LA CABECERA DEL RIEL: DONDE ESTAS, EN ESCRITORIO (2026-10-14) ----
                //
                // POR QUE HAY CABECERA EN ESCRITORIO, Y POR QUE VIVE EN EL RIEL: la regla del
                // proyecto es que **el titulo de arriba dice la SECCION** (doc:145: «el top app bar
                // dice DONDE ESTAS»), y sin ella el escritorio no diria en que seccion estas. Vivio
                // como texto suelto de 14 en el riel; aqui pasa a ser la cabecera de verdad.
                //
                // Y VA DENTRO DEL RIEL, NO ENCIMA DEL CONTENIDO, por una razon MEDIDA: la prueba
                // `el_armazon_de_escritorio_ocupa_la_ventana_y_sus_bloques_llevan_el_margen` exige
                // que el contenido mida el alto de la ventana ENTERO (0..800). Una franja de 64
                // encima lo desplazaria a 64..736 y ese contrato -- que es el del armazon de
                // escritorio ya aprobado -- se romperia. El riel es la columna de la NAVEGACION, y
                // en escritorio la navegacion lleva el titulo.
                //
                // Y ES LA MISMA FORMA QUE EN EL MOVIL (§3.1), no una parecida: alto 64
                // (`Medidas.cabecera`), fondo `sup`, el titulo a 22 px y peso 700, a la izquierda
                // con el margen de 16, centrado en los 64, y `banner` con `accessible-id:
                // "cabecera"` -- **una accion, una forma** (AU-41). Asi, la prueba que vigila que el
                // titulo sigue a la seccion es LA MISMA en los dos repartos.
                Rectangle {
                    accessible-role: banner;
                    accessible-id: "cabecera";
                    height: Medidas.cabecera;                          // doc:143  alto 64
                    background: root.oscuro ? Oscuro.sup : Claro.sup;  // doc:144  fondo `sup`
                    VerticalLayout {
                        padding: Medidas.margen;                       // doc:147  el margen de 16
                        alignment: center;                             // doc:148  centrado en los 64
                        Text {
                            text: root.titulo;
                            font-size: 22px;                           // doc:146  title-large
                            font-weight: 700;
                            color: root.oscuro ? Oscuro.fg : Claro.fg;
                            horizontal-alignment: left;
                            wrap: no-wrap;
                            overflow: TextOverflow.elide;
                        }
                    }
                }
                // ---- LAS ENTRADAS: ICONO + ETIQUETA, Y EL ACTIVO RESALTADO (encargo 2026-10-14) ----
                //
                // `estudio:86`, literal: «**El icono del riel de escritorio**: el riel es de
                // escritorio y hoy es texto; se puede añadir despues». Esto es ese «despues»: el riel
                // dibujaba solo el nombre y la barra del movil dibujaba icono + etiqueta, o sea que la
                // MISMA accion tenia DOS formas segun el ancho. Ahora las dos salen de `las_secciones`
                // (la MISMA lista, con su `icono`: AU-10) y el riel no tiene una tabla aparte.
                //
                // Y EL RESALTADO DEL ACTIVO SIGUE SIENDO EL DE ANTES (la fila entera en acento, con
                // su radio de 7), no la pildora del movil: la pildora es la forma de la barra (64 x
                // 32, doc:165) y en el riel lo aprobado es la fila. Lo que cambia es que el resaltado
                // pasa a ser una CAPA CON NOMBRE.
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 20px;
                    spacing: 4px;
                    for s[i] in root.secciones : Rectangle {
                        // LA ALTURA NO CAMBIA (36) y cumple el minimo de raton declarado:
                        // `Medidas.toque_raton` = 32, porque «en escritorio 32 px basta, el puntero
                        // apunta fino» (`LA-CARA-tema-y-reparto.md:51`).
                        height: 36px;
                        // LA ENTRADA SE BUSCA POR SU NOMBRE, como los huecos de la barra del movil
                        // (`nav-hueco-N`) y por lo mismo: sin nombre, una prueba dependeria de un
                        // tamano casual (AU-63).
                        accessible-role: button;
                        accessible-id: "riel-hueco-" + i;
                        background: transparent;
                        TouchArea { clicked => { root.elegir(i); } }
                        // EL RESALTADO: el mismo de siempre, ahora medible. Y EL ESTADO VA EN EL
                        // NOMBRE (`-si` / `-no`) porque **el fondo de una capa transparente NO se
                        // puede consultar** desde una prueba de geometria, y el tamano tampoco
                        // distingue la encendida de la apagada. Es la MISMA solucion que la pildora
                        // del movil (`nav-pildora-i-activa/-apagada`): asi «solo hay UNA activa» es
                        // una consulta, no una mirada.
                        Rectangle {
                            accessible-role: image;
                            accessible-id: "riel-activo-" + i + (s.activa ? "-si" : "-no");
                            width: parent.width;
                            height: parent.height;
                            border-radius: 7px;
                            background: s.activa ? (root.oscuro ? Oscuro.ac : Claro.ac) : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                // EL ICONO: 24, como el de la barra del movil (doc:162), y del
                                // catalogo de verdad, no un cuadrado de color (AU-90). Su tamano lo
                                // pone `tamano` (es `width`/`height` del `Path`, `iconos.slint:237-238`).
                                VerticalLayout {
                                    alignment: center;
                                    Icono {
                                        nombre: s.icono;
                                        tamano: 24px;
                                        // Activo `ac_txt` -- el color del texto que va SOBRE el
                                        // acento, porque aqui el fondo del activo es el acento OPACO
                                        // y no una pildora al 18 % como en el movil --, e inactivo
                                        // `muted` (doc:172-173).
                                        tono: s.activa ? (root.oscuro ? Oscuro.ac_txt : Claro.ac_txt)
                                                       : (root.oscuro ? Oscuro.muted : Claro.muted);
                                    }
                                }
                                // LA ETIQUETA, en su celda: se queda con el ancho que sobra y va
                                // centrada en el alto de la entrada.
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: s.nombre;
                                        font-size: 14px;
                                        horizontal-alignment: left;
                                        wrap: no-wrap;
                                        overflow: TextOverflow.elide;
                                        color: s.activa ? (root.oscuro ? Oscuro.ac_txt : Claro.ac_txt)
                                                        : (root.oscuro ? Oscuro.muted : Claro.muted);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // --- EL CONTENIDO: el unico que crece (AU-04) ---
        Rectangle {
            // EL ANCHO SE DERIVA, NO SE DEJA AL LAYOUT, y esto no es un capricho: esta MEDIDO hoy.
            // Con `horizontal-stretch`, el ancho del contenido lo decidiria el layout a partir de los
            // anchos PREFERIDOS de sus hijos -- y el `ScrollView` de dentro pide `parent.width`, o sea
            // que el layout y su hijo se preguntarian el uno al otro. Slint lo corta al compilar,
            // literal: «The binding for the property 'width' is part of a binding loop (layoutinfo-h ->
            // layout-cache -> width -> width -> width -> layoutinfo-h)». Derivandolo del ancho de la
            // VENTANA, la cadena va de arriba abajo y no hay ciclo. El armazon de movil no lo necesita
            // porque alli el ancho lo fija `Medidas.ancho`.
            // Y la cuenta es la del reparto: ventana - riel = 1280 - 176 = **1104**, que es justo lo
            // que mide la prueba de escritorio.
            width: root.ancho_ventana - Medidas.riel;
            height: root.alto_ventana;
            background: transparent;
            // EL NOMBRE DEL CONTENIDO, TAMBIEN EN ESCRITORIO (AU-63), y no es un adorno: **sin el, esta
            // rama no se podia medir** -- `buscar(&todos, "contenido")` no encontraba nada y la prueba
            // de escritorio no tenia que medir. El nombre es el mismo que el del armazon de movil
            // porque es la MISMA cosa: la zona donde viven los bloques de la seccion.
            accessible-role: main;
            accessible-id: "contenido";
            // ---- EL DESPLAZAMIENTO DEL CONTENIDO LARGO (AU-05; encargo del dueño 2026-10-14) ----
            //
            // AQUI NO HABIA `ScrollView`, y era correcto mientras el contenido no pasara de 800: decia
            // este mismo sitio, literal, «aqui NO hay `ScrollView` -- esta es la diferencia con el
            // armazon de movil». Pero el encargo pide que la ventana de escritorio sea RECORRIBLE: sin
            // esto, un contenido mas alto que la ventana **no tendria forma de verse entero**, y el
            // armazon de movil si lo tiene. Ahora los dos se desplazan.
            //
            // Y SE COPIA EL PATRON DEL MOVIL ENTERO, con sus dos motivos MEDIDOS, porque son los
            // mismos numeros:
            //   1. NADA DE `padding` DENTRO DEL `ScrollView`. Con un relleno ahi, el contenido se mide
            //      32 mas ancho de lo que cabe, el `ScrollView` concluye que hay algo que desplazar A
            //      LO ANCHO y **pinta su barra horizontal** (medido: una linea gris de 740 px de
            //      `#898887`). El margen de 16 lo lleva CADA BLOQUE, con sus dos huecos.
            //   2. EL AIRE DE ARRIBA Y DE ABAJO SON DOS HUECOS (`Rectangle` de `Medidas.margen`), no
            //      un relleno: **un hueco OCUPA sitio sin cambiar lo que mide su contenedor**.
            // Lo vigila `el_armazon_no_pone_el_margen_dentro_de_lo_que_se_desplaza`, que desde hoy
            // mira LOS DOS `ScrollView` del armazon y no solo el que aparezca primero.
            ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-stretch: 1;
                // El arrastre con el raton, que es lo que hace que el contenido se pueda RECORRER y no
                // solo mirar: el `ScrollView` es un control DE SERIE (AU-05, doc:190-192) y no se
                // reescribe. El del movil ya lo tenia.
                mouse-drag-pan-enabled: true;
                VerticalLayout {
                    Rectangle { height: Medidas.margen; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Medidas.hueco_bloques;
                        @children
                    }
                    Rectangle { height: Medidas.margen; }
                }
            }
        }
    }
}

// ---- EL ARMAZON DE MOVIL ----
//
// Sin riel, y con la navegacion ABAJO. Por que: en 411 dp, un riel de 176 se comeria el 43 % del
// ancho. Eso no es un diseno, es un desperdicio.
//
// ESTE ES EL ARMAZON DEL CONTRATO: el lienzo es 411 x 880 y **la barra de abajo no se mueve**.
export component ArmazonMovil inherits Rectangle {
    in property <bool> oscuro: false;
    in property <[Seccion]> secciones;
    // EL TITULO ES LA SECCION, no el nombre de la app (doc:145): el top app bar de Android dice
    // DONDE ESTAS. «Pulso» no va en la barra (auditoria:39, 44-45).
    in property <string> titulo;
    callback elegir(int);

    // EL TAMANO DE LA VENTANA: mantiene la barra ABAJO aunque no haya datos.
    width: Medidas.ancho;
    height: Medidas.alto;
    background: root.oscuro ? Oscuro.bg : Claro.bg;
    VerticalLayout {
        // --- La cabecera: el cromo de arriba (doc:139-154) ---
        cabecera := Rectangle {
            // `accessible-id` es la forma OFICIAL de identificar un elemento para PRUEBAS y para
            // accesibilidad. Buscar por el nombre del componente (`ArmazonMovil::cabecera`) funciona,
            // pero **depende de como se llame por dentro**: si alguien lo renombra, la prueba se rompe
            // sin que nada este mal. Con esto, el nombre es **una decision, no una consecuencia**.
            //
            // Y EXIGE UN PAPEL, y Slint lo dice al compilar: "The `accessible-id` property can only be
            // set in combination to `accessible-role`". Los papeles de referencia -- `banner`, `main`,
            // `navigation`, `region`, `form` -- **identifican las zonas grandes de la pantalla**, y son
            // los que un lector de pantalla usa para saltar de una a otra.
            accessible-role: banner;
            accessible-id: "cabecera";
            height: Medidas.cabecera;                  // doc:143  alto 64
            background: root.oscuro ? Oscuro.sup : Claro.sup;   // doc:144  fondo `sup` del tema
            // La cabecera es UN sitio con su contenido: el titulo va a la izquierda con el margen de
            // 16 y **centrado en los 64** (doc:147-148). Se hace con `padding` + `alignment: center`,
            // NO con `x` ni con `y`: dentro de un layout la posicion la manda el layout (doc:133,
            // `slint:19-35`). Estaba con `x:` y `vertical-alignment`, que es la trampa.
            VerticalLayout {
                padding: Medidas.margen;
                alignment: center;
                Text {
                    text: root.titulo;
                    // 22 px: title-large de Material 3 para el top app bar (`estudio:24`, doc:146).
                    // Peso 700, y la escala de tipografia es SOLO 22 / 14 / 12 (doc:54).
                    font-size: 22px;
                    font-weight: 700;
                    color: root.oscuro ? Oscuro.fg : Claro.fg;
                    horizontal-alignment: left;
                    // NO se recorta el texto: si un titulo no cupiera, se acorta el NOMBRE en la
                    // tabla de secciones, que es una decision (AU-68, doc:153-154).
                    wrap: no-wrap;
                    overflow: TextOverflow.elide;
                }
            }
        }
        // --- El contenido: apilado, con su margen y su hueco, y anclado (doc:176-192) ---
        Rectangle {
            // `main`: la zona del trabajo. Con `banner` arriba y `navigation` abajo, la pantalla
            // queda **navegable por zonas** para quien use un lector de pantalla.
            accessible-role: main;
            accessible-id: "contenido";
            vertical-stretch: 1;
            // ALTURA MINIMA DECLARADA: es lo que mantiene la barra de abajo PEGADA ABAJO aunque el
            // contenido sea corto (el estado sin datos). Medido: sin esto la barra subia al centro
            // (AU-93, doc:182-188). 880 - 64 - 80 = 736, declarado en `Medidas.alto_contenido`.
            min-height: Medidas.alto_contenido;
            background: transparent;
            // ---- EL MARGEN DE 16, EL SCROLLVIEW, Y LA LINEA GRIS QUE SALIO (medido) ----
            //
            // El margen de la pantalla es 16 por los cuatro lados (doc:180) y el armazon lo deja
            // puesto por CADA BLOQUE: aqui NO va el `padding`, y el por que esta medido. Con el
            // relleno en el layout que esta DENTRO del `ScrollView`, el contenido se mide a
            // 411 + 2·16 = 443; el `ScrollView` concluye que hay algo que desplazar **a lo ancho** y
            // PINTA SU BARRA: una linea gris de 370 px pegada al borde de abajo del contenido
            // (y = 794..795, #898887). Probado tambien con 20 de relleno: sale igual. Pedirle al
            // `ScrollView` su ancho y su alto no lo arregla, ni poner el relleno en el `Rectangle`
            // (Slint avisa: «padding only has effect on layout elements»).
            //
            // ASI QUE EL MARGEN LO LLEVA CADA BLOQUE, y hay una prueba que lo vigila
            // (`el_armazon_no_pone_el_margen_dentro_de_lo_que_se_desplaza`) y otra que lo exige
            // (`el_primer_bloque_del_contenido_empieza_con_el_margen_de_16`, **que hoy esta
            // IGNORADA: mide algo de la fase 2, y se des-ignora cuando los bloques apliquen
            // Medidas.margen**).
            ScrollView {
            width: parent.width;
            height: parent.height;
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;
                VerticalLayout {
                    // ---- EL AIRE DE ARRIBA Y DE ABAJO DEL CONTENIDO (doc:180, «por los CUATRO
                    // lados»), Y SON DOS HUECOS, NO UN RELLENO. ----
                    //
                    // POR QUE AQUI Y NO EN CADA BLOQUE, que es donde va el de los lados: el aire de
                    // los lados es de cada bloque (su caja mide 379, no 411, y asi el `ScrollView`
                    // no ve 443 donde caben 411); el de ARRIBA y ABAJO **no puede ser de cada
                    // bloque**, porque el `spacing` de 14 los sumaria en cada junta y el hueco entre
                    // bloques pasaria de los **14 del contrato (doc:181)** a 46. Es una distancia de
                    // los EXTREMOS, como el 14 lo es de las juntas: la pone el contenedor, UNA vez.
                    // Y el valor sigue siendo UNO: `Medidas.margen`.
                    //
                    // POR QUE ESTE LAYOUT DE FUERA NO ES EL QUE LLEVA EL `spacing`: medido el
                    // 2026-10-14, con los huecos DENTRO del layout que tiene `spacing`, el aire de
                    // arriba salia **30** (16 del hueco + 14 del `spacing`) en vez de 16. Los huecos
                    // van en un layout SIN `spacing`, y los bloques en el de dentro, que es el que
                    // los separa por 14. Asi el primer bloque empieza a 16 y los demas siguen a 14.
                    //
                    // POR QUE UN HUECO Y NO `padding-top`/`padding-bottom`: un relleno en el layout
                    // de dentro del `ScrollView` esta PROHIBIDO aqui, y hay una prueba que lo vigila
                    // (`el_armazon_no_pone_el_margen_dentro_de_lo_que_se_desplaza`): medido, el
                    // `ScrollView` pinta su barra. Un `Rectangle` sin relleno OCUPA sitio y **no
                    // cambia lo que mide su contenedor**; eso es lo que hacen estos dos.
                    Rectangle { height: Medidas.margen; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Medidas.hueco_bloques;   // doc:181  14 entre bloques
                        @children
                    }
                    Rectangle { height: Medidas.margen; }
                }
            }
        }
        // --- La navegacion: el cromo de abajo (doc:156-174) ---
        nav := Rectangle {
            // `navigation`: el papel de referencia que corresponde a una barra de navegacion.
            accessible-role: navigation;
            accessible-id: "navegacion";
            height: Medidas.nav_movil;                    // doc:160  alto 80
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            HorizontalLayout {
                // EL AIRE ENTRE HUECOS, y es lo que faltaba: sin esto los textos se PEGAN unos a
                // otros y sale «ResumenZonasSesionesDatos» -- que es lo que se vio en pantalla.
                // `spacing: 4` y `padding` lateral 4 (doc:169, `slint:37-53`), los dos de
                // `Medidas.aire_nav`: son la misma medida dicha una sola vez (AU-67).
                spacing: Medidas.aire_nav;
                padding-left: Medidas.aire_nav;
                padding-right: Medidas.aire_nav;
                for s[i] in root.secciones : Rectangle {
                    // REPARTIDO POR IGUAL, no al tamano del texto (AU-68, doc:161). Y el ancho va
                    // ESCRITO, no dejado al layout: con `horizontal-stretch` el hueco encogia a 64
                    // --el ancho de su contenido, la pildora-- y los cuatro se apelotonaban a la
                    // izquierda. Medido, no supuesto.
                    //
                    // Los 411 se reparten asi: el aire de los DOS extremos + el aire entre cada
                    // dos huecos (×3) + 4 huecos iguales. Con `Medidas.aire_nav` = 4:
                    //   (411 − 2·4 − 3·4) / 4 = **97,75** cada uno.
                    // Los dos numeros que pide el contrato estan dichos: el reparto puro es
                    // 411 / 4 = 102,75 (doc:161) y lo que queda con el aire es 97,75 (doc:169).
                    // El ancho se DERIVA de la ventana, no se escribe a mano.
                    //
                    // OJO, y es el limite de esto: el `4` de «cuatro huecos» es el numero de
                    // secciones, y Slint no deja sacarlo de la lista aqui (el ancho tiene que ser una
                    // constante en este punto). Con tres secciones, **esta linea se toca**, y por eso
                    // el divisor esta a la vista y no escondido en una cuenta.
                    width: (parent.width - 2 * Medidas.aire_nav - 3 * Medidas.aire_nav) / 4;
                    // Es UN HUECO, y se puede medir: la prueba de geometria cuenta cuatro y mide
                    // los cuatro. Sin nombre, la prueba dependeria de un tamano casual.
                    accessible-role: button;
                    accessible-id: "nav-hueco-" + i;
                    background: transparent;
                    // AREA TOCABLE de 48 dp como minimo: **el dedo no es un raton.** El hueco mide
                    // 80 de alto y 97,75 de ancho, asi que los 48 se cumplen de sobra: el area
                    // tactil es el hueco ENTERO (doc:166, `estudio:27`).
                    TouchArea { clicked => { root.elegir(i); } }
                    VerticalLayout {
                        // El grupo (pildora+icono arriba, etiqueta debajo) va CENTRADO en su hueco.
                        // El CENTRADO se hace con `padding` en horizontal, y no con `alignment`:
                        // medido, Slint ESTIRA los hijos de un layout hasta llenar el hueco, asi que
                        // `alignment: center` no movia nada y la pildora salia pegada a la izquierda
                        // (x = 4 en un hueco que empieza en 4). El hueco que sobra es
                        // (ancho del hueco - 64 de la pildora) / 2, y ese es el relleno.
                        padding-left: (parent.width - 64px) / 2;
                        padding-right: (parent.width - 64px) / 2;
                        alignment: center;
                        spacing: 2px;
                        // EL INDICADOR DEL ACTIVO: una PILDORA tras el icono, que es el patron de la
                        // barra de navegacion de Android (Material 3), NO la linea de 2 px de antes.
                        // 64 x 32, radio 16, acento al 18 % (doc:165, `estudio:26`). Va DETRAS porque
                        // en Slint el orden del arbol es el orden de pintado: se declara ANTES.
                        //
                        // La pildora y su icono van en una FILA de 64 x 32 -- lo que mide la pildora--,
                        // porque asi el centrado del grupo es el centrado de la fila.
                        HorizontalLayout {
                            width: 64px;
                            height: 32px;
                            Rectangle {
                                // La pildora es un ADORNO de la barra, y se puede medir por su
                                // nombre: el contenedor, la fila y la capa de dentro miden 64 x 32
                                // igual que ella, asi que buscarla por tamano encuentra cuatro.
                                // Medido: cuatro por hueco, 16 en total.
                                accessible-role: image;
                                // Y EL NOMBRE LLEVA EL ESTADO, que es lo que hace medible «solo
                                // hay UNA encendida»: el fondo de una capa transparente NO se puede
                                // consultar desde una prueba, y **medir el tamano no distingue** la
                                // pildora encendida de la apagada (las dos miden 64 x 32). Con el
                                // estado en el nombre, el portero de «una sola forma» (AU-41) y el
                                // de «una sola activa» (doc:165) son la misma consulta.
                                accessible-id: "nav-pildora-" + i + (s.activa ? "-activa" : "-apagada");
                                width: 64px;
                                height: 32px;
                                border-radius: 16px;
                                background: s.activa
                                    ? (root.oscuro ? Oscuro.ac : Claro.ac).with-alpha(0.18)
                                    : transparent;
                                // El icono de DENTRO de la pildora: una celda de 24 x 24, que es justo
                                // el tamano del icono. Medido: pidiendo 24 con `padding`, el icono
                                // salia a 22 (1 px por lado) y quedaba descentrado en la pildora;
                                // con la celda cuadrada cae en su centro exacto.
                                VerticalLayout {
                                    width: 24px;
                                    height: 24px;
                                    Icono {
                                        // 24 dp: el tamano del icono en la barra de Android
                                        // (`estudio:25`, doc:162). Y es un icono REAL del catalogo de
                                        // 187 (`iconos.slint`), no un cuadrado de color (AU-90).
                                        nombre: s.icono;
                                        tamano: 24px;
                                        // Inactivo `muted`, activo `ac` (doc:172-173).
                                        tono: s.activa ? (root.oscuro ? Oscuro.ac : Claro.ac)
                                                       : (root.oscuro ? Oscuro.muted : Claro.muted);
                                    }
                                }
                            }
                        }
                        Text {
                            text: s.nombre;
                            // 12 px: label-medium de Material 3 (antes 11), CENTRADA en su hueco.
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: no-wrap;
                            overflow: TextOverflow.elide;
                            color: s.activa ? (root.oscuro ? Oscuro.ac : Claro.ac)
                                            : (root.oscuro ? Oscuro.muted : Claro.muted);
                        }
                    }
                }
            }
        }
    }
}
