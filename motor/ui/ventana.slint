// LA VENTANA: el motor enseñado, con el armazon y el tema.
//
// REGLA QUE CUMPLE, y es la mas importante del proyecto (AU-44 y la norma del motor):
// **AQUI NO SE CALCULA NADA.** Los numeros llegan ya calculados por el motor, en Rust, con su margen
// y su fuente. Si aqui hubiera una sola cuenta, el dia que se cambie una formula **la pantalla
// mentiria sin avisar**.
//
// Y EL TEXTO JUSTO (AU-44 y AU-45): la pantalla MUESTRA. Lo que se explica va en la ayuda, y se pide.
// Un vacio se dice en UNA linea, no en un parrafo.

import { Claro, Oscuro } from "temas.slint";
import { ArmazonEscritorio, ArmazonMovil, Medidas, Seccion } from "armazon.slint";
// EL SELECTOR DE CARPETA, en su propio fichero: es una capa superpuesta y no toca la navegacion.
import { EntradaCarpeta, SelectorCarpeta } from "selector.slint";
// LOS CONTROLES DE SERIE, que son una decision tomada del dueño: traen probado el foco, el teclado,
// el estado pulsado y la accesibilidad, que es justo lo que habria que construir y probar a mano.
// Lo que NO traen son nuestros colores; eso se resuelve abajo, en la raiz, con `Palette`.
import { ComboBox, Button, LineEdit, RadioGroup, Switch, Palette } from "std-widgets.slint";

// LO QUE LA PANTALLA ENTREGA AL GUARDAR. **Todo son textos, incluso los numeros**: la interfaz no
// valida, no convierte y no calcula — solo entrega lo que el usuario escribio. Traducirlo a datos
// del motor es trabajo de Rust (`profile::de_campos`), y ahi esta la unica regla que importa:
// **un campo vacio es «no lo sé», no un cero.**
//
// Se entrega como ESTRUCTURA y no como una lista de textos sueltos para que cada dato viaje con su
// nombre: con una lista, cambiar dos campos de sitio seria un fallo silencioso.
export struct DatosPersona {
    edad: string,
    pulso_reposo: string,
    pulso_maximo_medido: string,
    peso_kg: string,
    altura_cm: string,
    grasa_corporal_pct: string,
    masa_muscular_kg: string,
    umbral_lactato: string,
    vo2_maximo: string,
    // 0 femenino, 1 masculino, 2 «no lo sé». El 2 no es un adorno: un `RadioGroup` no se puede
    // desmarcar, y sin esa opcion el que se equivoca al pulsar **no puede volver a decir que no lo
    // sabe** — o sea, el «no lo sé» dejaria de existir por un accidente de la interfaz.
    sexo: int,
}

// ---- Las piezas que se repiten, declaradas UNA vez (AU-41: una accion, una forma) ----

// Una cifra: el numero, su etiqueta, y su margen si lo tiene.
// EL MARGEN VA CON EL NUMERO, no en una nota al pie: es lo que este motor tiene de distinto, y
// esconderlo seria quedarse con lo de siempre.
component Cifra inherits Rectangle {
    // El id permite MEDIRLO desde las pruebas (AU-63).
    in property <string> numero;
    in property <string> etiqueta;
    in property <bool> oscuro: false;
    in property <bool> destacada: false;

    height: 66px;
    border-radius: Medidas.radio;
    background: root.oscuro ? Oscuro.sup : Claro.sup;
    border-width: 1px;
    // El borde DELIMITA, no enmarca: en el boceto apenas se insinua. Con 1 px basta.
    border-color: (root.oscuro ? Oscuro.linea : Claro.linea).with-alpha(0.45);

    VerticalLayout {
        // 12, como el diseno. Estaba en 14: otro valor cambiado sin decirlo.
        padding: 12px;
        spacing: 3px;
        Text {
            text: root.numero;
            font-size: 26px;
            font-weight: 700;
            // El acento SOLO en las dos primeras: son las que el cliente mira.
            color: root.destacada ? (root.oscuro ? Oscuro.ac : Claro.ac)
                                  : (root.oscuro ? Oscuro.fg : Claro.fg);
        }
        Text {
            text: root.etiqueta;
            font-size: 12px;
            color: root.oscuro ? Oscuro.muted : Claro.muted;
        }
    }
}

// Una zona: el nombre, su tramo, y la barra.
// EL ANCHO ES PROPORCIONAL AL LIMITE: si el limite sube, la barra crece. **No es decoracion.**
component Zona inherits Rectangle {
    in property <string> nombre;
    in property <string> tramo;
    in property <int> nivel;        // 0 a 100
    in property <color> tono;
    in property <bool> oscuro: false;
    // La pista: el mismo color, muy suave. **No gris**, porque el gris iguala las cinco zonas.
    in property <color> pista_zona: transparent;

    height: 40px;
    background: transparent;

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text {
                text: root.nombre; font-size: 12px;
                color: root.oscuro ? Oscuro.muted : Claro.muted;
                horizontal-stretch: 1;
            }
            Text {
                text: root.tramo; font-size: 12px;
                color: root.oscuro ? Oscuro.fg : Claro.fg;
            }
        }
        Rectangle {
            height: 10px;
            border-radius: 5px;
            background: root.pista_zona;
            Rectangle {
                width: parent.width * root.nivel / 100;
                height: parent.height;
                border-radius: 5px;
                background: root.tono;
            }
        }
    }
}

// Una linea de aviso: el punto, y UNA frase. Ni un parrafo ni una explicacion.
component Aviso inherits Rectangle {
    in property <string> texto;
    in property <bool> oscuro: false;
    height: 44px;
    border-radius: Medidas.radio;
    background: root.oscuro ? Oscuro.pista : Claro.pista;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px; height: 10px; border-radius: 5px;
                background: root.oscuro ? Oscuro.ok : Claro.ok;
            }
        }
        Text {
            text: root.texto; font-size: 12px;
            color: root.oscuro ? Oscuro.fg : Claro.fg;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
}

// EL COMPONENTE RAIZ elige el armazon segun el espacio. NO pregunta por el dispositivo:
// pregunta por el ANCHO, que es lo unico que importa -- **una ventana de escritorio estrecha es un
// movil a efectos de reparto.**
component Contenido inherits VerticalLayout {
    in property <bool> oscuro: false;
    in property <[string]> cifras;
    in property <[string]> etiquetas;
    in property <[string]> zonas_nombres;
    in property <[string]> zonas_tramos;
    in property <[int]> zonas_niveles;
    in property <string> precision;
    in property <string> aviso;
    in property <string> vacio;

    spacing: 12px;
    HorizontalLayout {
        spacing: 12px;
        Cifra { horizontal-stretch: 1; numero: root.cifras[0]; etiqueta: root.etiquetas[0]; oscuro: root.oscuro; destacada: true; }
        Cifra { horizontal-stretch: 1; numero: root.cifras[1]; etiqueta: root.etiquetas[1]; oscuro: root.oscuro; destacada: true; }
    }
    HorizontalLayout {
        spacing: 12px;
        Cifra { horizontal-stretch: 1; numero: root.cifras[2]; etiqueta: root.etiquetas[2]; oscuro: root.oscuro; }
        Cifra { horizontal-stretch: 1; numero: root.cifras[3]; etiqueta: root.etiquetas[3]; oscuro: root.oscuro; }
    }
    Rectangle {
        height: 268px;
        border-radius: Medidas.radio;
        background: root.oscuro ? Oscuro.sup : Claro.sup;
        border-width: 1px;
        border-color: root.oscuro ? Oscuro.linea : Claro.linea;
        VerticalLayout {
            padding: 14px;
            spacing: 4px;
            Text {
                text: "Zonas de entrenamiento";
                font-size: 14px; font-weight: 700;
                color: root.oscuro ? Oscuro.fg : Claro.fg;
            }
            for i in 5 : Zona {
                nombre: root.zonas_nombres[i];
                tramo: root.zonas_tramos[i];
                nivel: root.zonas_niveles[i];
                oscuro: root.oscuro;
                tono: i == 0 ? (root.oscuro ? Oscuro.z1 : Claro.z1)
                    : i == 1 ? (root.oscuro ? Oscuro.z2 : Claro.z2)
                    : i == 2 ? (root.oscuro ? Oscuro.z3 : Claro.z3)
                    : i == 3 ? (root.oscuro ? Oscuro.z4 : Claro.z4)
                             : (root.oscuro ? Oscuro.z5 : Claro.z5);
                // La pista, del mismo color pero muy suave: se VE que la barra es de esa zona.
                pista_zona: (i == 0 ? (root.oscuro ? Oscuro.z1 : Claro.z1)
                    : i == 1 ? (root.oscuro ? Oscuro.z2 : Claro.z2)
                    : i == 2 ? (root.oscuro ? Oscuro.z3 : Claro.z3)
                    : i == 3 ? (root.oscuro ? Oscuro.z4 : Claro.z4)
                             : (root.oscuro ? Oscuro.z5 : Claro.z5)).with-alpha(0.18);
            }
        }
    }
    Aviso { texto: root.precision; oscuro: root.oscuro; }
    Rectangle {
        height: 52px;
        border-radius: Medidas.radio;
        background: root.oscuro ? Oscuro.sup : Claro.sup;
        border-width: 1px;
        border-color: root.oscuro ? Oscuro.linea : Claro.linea;
        Text {
            text: root.vacio; font-size: 13px;
            color: root.oscuro ? Oscuro.muted : Claro.muted;
            x: 14px; vertical-alignment: center;
        }
    }
    Aviso { texto: root.aviso; oscuro: root.oscuro; }
}

// ================================================================================================
// LA SECCION «DATOS»: los datos de la persona, y **son suyos**.
// ================================================================================================
//
// POR QUE ES LA SECCION QUE MAS IMPORTA: hasta hoy los datos de la persona estaban **escritos en el
// codigo**, asi que los resultados que enseñaba la pantalla **no eran del cliente, eran de quien
// compilo el programa** -- y eso no se veia: los numeros tenian buena cara.
//
// Y AQUI NO HAY `Slider` NI `SpinBox`, que seria lo comodo: un deslizador obliga a fijar un MINIMO y
// un MAXIMO, y **ese rango seria una decision inventada** sobre el cuerpo de una persona. Se usan
// campos de texto, y decide el motor: el que escriba «900» vera que el motor no lo acepta.

// UN CAMPO: la etiqueta, y el control de serie DENTRO de un marco nuestro.
//
// POR QUE EL MARCO, y esta medido de la fuente del estilo: en el tema negro el borde del campo es
// blanco al 8 % sobre negro (**~1,1:1**, minimo 3:1) y su relleno es blanco al 6 %, o sea que **el
// campo no se ve**: solo se ve lo que se escribe dentro. El contorno lo pone un `Rectangle` NUESTRO
// por fuera -- la salida que ya esta probada en `sonda-borde.slint`, donde se comprobo que el marco
// no recorta al control si el hueco lo pone el `padding` del layout.
component Campo inherits VerticalLayout {
    in property <string> etiqueta;
    // `accessible-id` es la forma OFICIAL de encontrar un elemento desde las pruebas, y **exige un
    // papel de accesibilidad**: el del `LineEdit` ya viene puesto por el estilo, y la prueba lo
    // comprueba.
    in property <string> identificador;
    in property <string> pista;
    in-out property <string> texto;
    in property <bool> oscuro: false;

    spacing: 3px;
    Text {
        text: root.etiqueta;
        font-size: 11px;
        color: root.oscuro ? Oscuro.muted : Claro.muted;
    }
    Rectangle {
        border-width: 1px;
        border-color: root.oscuro ? Oscuro.linea : Claro.linea;
        border-radius: Medidas.radio;
        // La altura se le PIDE AL HIJO. Calcularla con `self.preferred-height + 4px` fue el fallo que
        // se cazo midiendo en la sonda: el marco salia de 4 px de alto y el control se salia.
        height: self.preferred-height;
        VerticalLayout {
            padding: 2px;
            LineEdit {
                accessible-id: root.identificador;
                text <=> root.texto;
                placeholder-text: root.pista;
                // El minimo tactil del proyecto son 48 dp y el estilo trae 32: **hay que pedirlo**.
                // Con `max()` y no con un 48 fijo: asi, el dia que el texto necesite mas alto, el
                // campo crece en vez de recortarlo.
                height: max(48px, self.preferred-height);
            }
        }
    }
}

component Datos inherits VerticalLayout {
    in-out property <DatosPersona> campos;
    in-out property <bool> oscuro: false;
    in property <string> mensaje;
    in property <bool> error: false;
    in property <string> ruta;
    callback guardar;
    // Abre la capa del selector. La capa se dibuja en la VENTANA, no aqui: este panel solo pide.
    callback abrir-selector;

    spacing: 10px;

    Text {
        text: "Sus datos";
        font-size: 15px; font-weight: 700;
        color: root.oscuro ? Oscuro.fg : Claro.fg;
    }
    // UNA linea, y dice lo unico que hay que saber antes de escribir: que dejarlo vacio es una
    // respuesta valida y significa «no lo sé».
    Text {
        text: "Lo que ningún aparato puede saber. Un campo vacío es «no lo sé», no un cero.";
        font-size: 11px;
        wrap: word-wrap;
        color: root.oscuro ? Oscuro.muted : Claro.muted;
    }

    // LOS CAMPOS, en dos columnas: a la izquierda los del corazon y el esfuerzo, a la derecha los de
    // la bascula. Es la agrupacion que el cliente ya usa al hablar de sus datos, y ademas hace que
    // los diez quepan sin desplazar la pantalla.
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            Campo { etiqueta: "Edad"; identificador: "datos-edad"; pista: "años"; texto <=> root.campos.edad; oscuro: root.oscuro; }
            Campo { etiqueta: "Pulso en reposo"; identificador: "datos-pulso_reposo"; pista: "ppm, durmiendo"; texto <=> root.campos.pulso_reposo; oscuro: root.oscuro; }
            Campo { etiqueta: "Pulso máximo"; identificador: "datos-pulso_maximo_medido"; pista: "ppm, medido"; texto <=> root.campos.pulso_maximo_medido; oscuro: root.oscuro; }
            Campo { etiqueta: "Umbral de lactato"; identificador: "datos-umbral_lactato"; pista: "ppm, de una prueba"; texto <=> root.campos.umbral_lactato; oscuro: root.oscuro; }
            Campo { etiqueta: "VO₂ máximo"; identificador: "datos-vo2_maximo"; pista: "ml/kg/min"; texto <=> root.campos.vo2_maximo; oscuro: root.oscuro; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            Campo { etiqueta: "Peso"; identificador: "datos-peso_kg"; pista: "kg"; texto <=> root.campos.peso_kg; oscuro: root.oscuro; }
            Campo { etiqueta: "Altura"; identificador: "datos-altura_cm"; pista: "cm"; texto <=> root.campos.altura_cm; oscuro: root.oscuro; }
            Campo { etiqueta: "Grasa corporal"; identificador: "datos-grasa_corporal_pct"; pista: "%"; texto <=> root.campos.grasa_corporal_pct; oscuro: root.oscuro; }
            Campo { etiqueta: "Masa muscular"; identificador: "datos-masa_muscular_kg"; pista: "kg"; texto <=> root.campos.masa_muscular_kg; oscuro: root.oscuro; }
        }
    }

    // EL SEXO. Se deja SIN marco a proposito: el circulo del `RadioButton` es blanco al 60 %, que
    // sobre negro da mas de 7:1 -- o sea, aqui el estilo SI dibuja lo que hace falta. Poner un marco
    // donde no falta es ruido.
    // EL SEXO, con un `ComboBox` y NO con un `RadioGroup`.
    //
    // POR QUE, y esta MEDIDO a golpes: el `RadioGroup` de Slint 1.18 **no deja escribir su indice
    // desde fuera** -- `current-index <=> ...` da «Unknown property current-index in RadioGroup»,
    // aunque la propiedad SI existe en el estilo (`radiogroup-base.slint`). Y el mensaje engaña,
    // porque señala a una propiedad que esta.
    //
    // El `ComboBox` si deja: se le da el `model` y se lee y escribe `current-index`. Y para TRES
    // opciones excluyentes es ademas lo que la norma pide: **una accion, una forma**.
    ComboBox {
        accessible-id: "datos-sexo";
        model: ["No lo sé", "Femenino", "Masculino"];
        current-index: root.campos.sexo;
        // El callback entrega el TEXTO, y nuestro campo es un indice: se traduce aqui, que es donde
        // esta la lista. Traducir en Rust obligaria a que Rust conociera los rotulos de la pantalla.
        selected(t) => {
            root.campos.sexo = t == "Femenino" ? 1 : (t == "Masculino" ? 2 : 0);
        }
    }

    // GUARDAR. El boton va dentro de un marco nuestro por lo mismo que los campos, y esta medido: en
    // el tema negro el borde de serie del boton da **1,14:1** y **no se ve** -- un boton sin contorno,
    // sobre negro, parece un rotulo.
    Rectangle {
        border-width: 2px;
        border-color: root.oscuro ? Oscuro.linea : Claro.linea;
        border-radius: 8px;
        height: self.preferred-height;
        VerticalLayout {
            // El hueco entre el borde y el boton lo pone el `padding`, no una cuenta.
            padding: 2px;
            Button {
                accessible-id: "datos-guardar";
                height: max(48px, self.preferred-height);
                text: "Guardar mis datos";
                primary: true;
                clicked => { root.guardar(); }
            }
        }
    }

    // LO QUE PASO AL GUARDAR, en una linea: o se guardo, o se dice que campo esta mal. **Un numero mal
    // escrito no se traga en silencio**: guardar un cero donde el usuario no escribio nada seria un
    // dato falso con buena cara, que es justo lo que este proyecto no hace.
    Text {
        accessible-id: "datos-mensaje";
        text: root.mensaje;
        font-size: 12px;
        wrap: word-wrap;
        color: root.error
            ? (root.oscuro ? Oscuro.aviso : Claro.aviso)
            : (root.oscuro ? Oscuro.ok : Claro.ok);
    }

    // DONDE VIVEN SUS DATOS, y no es un detalle: el dueño decidio que el fichero viaje JUNTO AL
    // PROGRAMA, y si no se pudo escribir ahi hay que decirlo, porque el usuario tiene derecho a saber
    // donde estan sus datos.
    Text {
        accessible-id: "datos-ruta";
        text: root.ruta;
        font-size: 11px;
        wrap: word-wrap;
        color: root.oscuro ? Oscuro.muted : Claro.muted;
    }

    // BUSCAR SUS FICHEROS. Es EL ATAJO QUE MAS VALE: sin cuenta, ni permiso, ni internet, porque sus
    // datos ya estan en su equipo. Abre la capa del selector, que se dibuja sobre la ventana entera.
    Rectangle {
        border-width: 2px;
        border-color: root.oscuro ? Oscuro.linea : Claro.linea;
        border-radius: 8px;
        height: self.preferred-height;
        VerticalLayout {
            padding: 2px;
            Button {
                accessible-id: "datos-buscar";
                height: max(48px, self.preferred-height);
                text: "Buscar mis ficheros";
                clicked => { root.abrir-selector(); }
            }
        }
    }

    // EL TEMA. Manda SIEMPRE el nuestro, nunca el del sistema (ver `Palette` en la raiz), y este es
    // el mando: cambiar de tema es cambiar UNA propiedad.
    Switch {
        accessible-id: "datos-tema";
        checked <=> root.oscuro;
        text: "Tema oscuro";
    }
}

export component Ventana inherits Window {
    // LOS NOMBRES DE LOS SITIOS, para poder MEDIRLOS desde las pruebas (AU-63).
    // No son decorativos: sin un nombre, un elemento no se puede consultar ni medir.
    // Lo que el motor entrega. TODO son cadenas: la ventana NO formatea numeros, los recibe hechos.
    in property <[string]> cifras;
    in property <[string]> etiquetas;
    in property <[string]> zonas_nombres;
    in property <[string]> zonas_tramos;
    in property <[int]> zonas_niveles;
    in property <string> precision;
    in property <string> aviso;
    in property <string> vacio;
    // EL TEMA. Cambiar de tema es cambiar ESTA linea: ninguna pieza se toca (AU-39).
    // Es `in-out` y no `in` porque el mando del tema vive DENTRO de la pantalla (el `Switch` de la
    // seccion «Datos»): un `in` solo lo puede escribir quien crea la ventana, y el usuario no es ese.
    in-out property <bool> oscuro: false;

    // LA SECCION ELEGIDA, y lo que decide que se enseña. Es estado de la pantalla, no del motor.
    in-out property <int> seccion_activa: 0;

    // LOS DATOS DE LA PERSONA, tal como estan en los campos. Arrancan VACIOS y con «no lo sé» en el
    // sexo: antes de que Rust lea el perfil, la pantalla no puede enseñar un dato que no tiene.
    in-out property <DatosPersona> campos: {
        edad: "", pulso_reposo: "", pulso_maximo_medido: "", peso_kg: "", altura_cm: "",
        grasa_corporal_pct: "", masa_muscular_kg: "", umbral_lactato: "", vo2_maximo: "", sexo: 2,
    };
    // Lo que paso al guardar, y donde quedaron los datos.
    in property <string> mensaje_guardado;
    in property <bool> error_al_guardar: false;
    in property <string> ruta_del_perfil;

    // ---- EL SELECTOR DE CARPETA: la capa que se superpone para elegir donde estan sus ficheros ----
    // Todo lo de abajo lo calcula Rust con `carpeta::abrir`. Aqui solo se dibuja.
    in-out property <bool> eligiendo: false;
    in property <string> carpeta_ruta;
    in property <int> carpeta_fit: 0;
    in property <bool> carpeta_puede_subir: false;
    in property <string> carpeta_aviso;
    in property <[EntradaCarpeta]> carpetas;
    callback abrir-selector;
    callback cerrar-selector;
    callback subir-carpeta;
    callback usar-carpeta;
    callback elegir-subcarpeta(int);

    // PARA MEDIR EL TEMA DE LOS CONTROLES DE SERIE DESDE UNA PRUEBA: no hay otra forma de consultar
    // un global de Slint desde Rust, y esta linea es la que demuestra que el esquema sigue a nuestro
    // tema en vez de al del sistema.
    out property <bool> controles_en_oscuro: Palette.color-scheme == ColorScheme.dark;

    title: "Pulso";
    // SIN EL MARCO DEL SISTEMA, y no es un capricho: la barra de ventana de arriba **no es parte de
    // la aplicacion**, y en el telefono no existe. Enseñarla en el escritorio hace que la ventana
    // parezca un programa a medio hacer -- y ademas come 30 px de alto.
    no-frame: true;
    width: 411px;
    height: 880px;
    background: root.oscuro ? Oscuro.bg : Claro.bg;

    // La unica decision de reparto: ¿cabe el riel?
    // NO se pregunta por el dispositivo -- se pregunta por el ESPACIO. **Una ventana de escritorio
    // estrecha es un movil a efectos de reparto.**
    property <bool> es_movil: root.width < Medidas.corte;

    // Las secciones, declaradas UNA vez y usadas por los dos armazones (AU-10).
    property <[Seccion]> las_secciones: [
        { nombre: "Resumen", activa: root.seccion_activa == 0 },
        { nombre: "Zonas", activa: root.seccion_activa == 1 },
        { nombre: "Sesiones", activa: root.seccion_activa == 2 },
        { nombre: "Datos", activa: root.seccion_activa == 3 },
    ];

    callback elegir(int);
    // El armazon avisa de la seccion elegida, y aqui se cambia lo que se enseña. Estaba en Rust y
    // hacia otra cosa: alternaba el tema al pulsar «Datos», que era un apaño mientras no habia mas
    // pantallas. **El tema tiene su propio mando, y este callback hace lo que dice su nombre.**
    elegir(i) => { root.seccion_activa = i; }

    // LA INTERFAZ ENTREGA, RUST GUARDA. Aqui no se valida nada: los textos salen tal cual y es Rust
    // quien los traduce, los comprueba y los escribe en el fichero.
    callback guardar-datos(DatosPersona);

    // EL TEMA DE LOS CONTROLES DE SERIE SE FIJA DESDE EL NUESTRO, NUNCA DESDE EL DEL SISTEMA.
    //
    // POR QUE, y esta medido (`temas/contraste-widgets.py`): los controles de serie sacan sus colores
    // del esquema del sistema. Si el sistema esta en oscuro y nuestra pantalla en claro, el texto del
    // control sale blanco sobre crema: **1,05:1**, con minimo 4,5:1. O sea: **el texto desaparece**.
    //
    // Y ES UN BINDING, no un `init`: `init` corre UNA vez al arrancar, y el usuario cambia de tema
    // cuando quiere. Con el binding, el esquema de los controles **sigue** a nuestro tema.
    init => { Palette.color-scheme = root.oscuro ? ColorScheme.dark : ColorScheme.light; }

    if root.es_movil : ArmazonMovil {
        // El armazon de movil, medible.
        oscuro: root.oscuro;
        titulo: "Pulso";
        secciones: root.las_secciones;
        elegir(i) => { root.elegir(i); }
        if root.seccion_activa == 3 : Datos {
            oscuro <=> root.oscuro;
            campos <=> root.campos;
            mensaje: root.mensaje_guardado;
            error: root.error_al_guardar;
            ruta: root.ruta_del_perfil;
            guardar => { root.guardar-datos(root.campos); }
            abrir-selector => { root.abrir-selector(); }
        }
        if root.seccion_activa != 3 : Contenido {
            oscuro: root.oscuro;
            cifras: root.cifras; etiquetas: root.etiquetas;
            zonas_nombres: root.zonas_nombres; zonas_tramos: root.zonas_tramos;
            zonas_niveles: root.zonas_niveles;
            precision: root.precision; aviso: root.aviso; vacio: root.vacio;
        }
    }

    if !root.es_movil : ArmazonEscritorio {
        oscuro: root.oscuro;
        titulo: "Pulso";
        secciones: root.las_secciones;
        elegir(i) => { root.elegir(i); }
        if root.seccion_activa == 3 : Datos {
            oscuro <=> root.oscuro;
            campos <=> root.campos;
            mensaje: root.mensaje_guardado;
            error: root.error_al_guardar;
            ruta: root.ruta_del_perfil;
            guardar => { root.guardar-datos(root.campos); }
            abrir-selector => { root.abrir-selector(); }
        }
        if root.seccion_activa != 3 : Contenido {
            oscuro: root.oscuro;
            cifras: root.cifras; etiquetas: root.etiquetas;
            zonas_nombres: root.zonas_nombres; zonas_tramos: root.zonas_tramos;
            zonas_niveles: root.zonas_niveles;
            precision: root.precision; aviso: root.aviso; vacio: root.vacio;
        }
    }

    // LA CAPA, DECLARADA LA ULTIMA para quedar POR ENCIMA de los dos armazones.
    if root.eligiendo : SelectorCarpeta {
        oscuro: root.oscuro;
        ruta: root.carpeta_ruta;
        fit_aqui: root.carpeta_fit;
        puede_subir: root.carpeta_puede_subir;
        aviso: root.carpeta_aviso;
        carpetas: root.carpetas;
        subir => { root.subir-carpeta(); }
        usar => { root.usar-carpeta(); }
        elegir(i) => { root.elegir-subcarpeta(i); }
        cerrar => { root.cerrar-selector(); }
    }
}
