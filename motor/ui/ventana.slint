// LA VENTANA: el motor enseñado, con el armazon y el tema.
//
// REGLA QUE CUMPLE, y es la mas importante del proyecto (AU-44 y la norma del motor):
// **AQUI NO SE CALCULA NADA.** Los numeros llegan ya calculados por el motor, en Rust, con su margen
// y su fuente. Si aqui hubiera una sola cuenta, el dia que se cambie una formula **la pantalla
// mentiria sin avisar**.
//
// Y EL TEXTO JUSTO (AU-44 y AU-45): la pantalla MUESTRA. Lo que se explica va en la ayuda, y se pide.
// Un vacio se dice en UNA linea, no en un parrafo.

import { Claro, Oscuro } from "temas.slint";
import { ArmazonEscritorio, ArmazonMovil, Medidas, Seccion } from "armazon.slint";
// LOS ICONOS DE VERDAD, del catalogo (`iconos.slint`). El aviso del Resumen dibujaba un CIRCULO DE
// COLOR de 10 px, y eso no es un icono: la especificacion pide uno real (§3.7, AU-90).
import { Icono } from "iconos.slint";
// EL SELECTOR DE CARPETA, en su propio fichero: es una capa superpuesta y no toca la navegacion.
import { EntradaCarpeta, SelectorCarpeta } from "selector.slint";
// LOS CONTROLES DE SERIE, que son una decision tomada del dueño: traen probado el foco, el teclado,
// el estado pulsado y la accesibilidad, que es justo lo que habria que construir y probar a mano.
// Lo que NO traen son nuestros colores; eso se resuelve abajo, en la raiz, con `Palette`.
import { ComboBox, Button, LineEdit, RadioGroup, Switch, Palette } from "std-widgets.slint";

// LO QUE LA PANTALLA ENTREGA AL GUARDAR. **Todo son textos, incluso los numeros**: la interfaz no
// valida, no convierte y no calcula — solo entrega lo que el usuario escribio. Traducirlo a datos
// del motor es trabajo de Rust (`profile::de_campos`), y ahi esta la unica regla que importa:
// **un campo vacio es «no lo sé», no un cero.**
//
// Se entrega como ESTRUCTURA y no como una lista de textos sueltos para que cada dato viaje con su
// nombre: con una lista, cambiar dos campos de sitio seria un fallo silencioso.
export struct DatosPersona {
    edad: string,
    pulso_reposo: string,
    pulso_maximo_medido: string,
    peso_kg: string,
    altura_cm: string,
    grasa_corporal_pct: string,
    masa_muscular_kg: string,
    umbral_lactato: string,
    vo2_maximo: string,
    // 0 femenino, 1 masculino, 2 «no lo sé». El 2 no es un adorno: un `RadioGroup` no se puede
    // desmarcar, y sin esa opcion el que se equivoca al pulsar **no puede volver a decir que no lo
    // sabe** — o sea, el «no lo sé» dejaria de existir por un accidente de la interfaz.
    sexo: int,
}

// ---- LO QUE EL MOTOR ENTREGA A LA PANTALLA (Fase 2: `docs/CONTRATO-cara-datos.md`) ----
//
// POR QUE DOS ESTRUCTURAS Y NO CINCO LISTAS PARALELAS (AU-73): con listas paralelas, el dia que una
// cifra no existe y se quita, **las etiquetas se desalinean** y la pantalla miente sin que ninguna
// prueba lo vea. Aqui cada dato viaja con lo suyo dentro.

// UNA TARJETA DE CIFRA: el numero ya escrito, y su etiqueta. **Las dos cosas juntas.**
//
// OJO CON LO QUE ESTA ESTRUCTURA NO TIENE: no hay campo para «esta cifra no existe». El motor manda
// SOLO las que existen (`dato: Some`, contrato 2), asi que una tarjeta sin dato **no se puede
// construir aqui**: no es que la vista se acuerde de no dibujarla, es que no llega.
export struct TarjetaCifra {
    numero: string,
    etiqueta: string,
}

// UNA ZONA, EN PULSACIONES: lo que hace falta para pintar SU BANDA sobre el eje comun.
//
// LOS NUMEROS VAN CRUDOS (contrato 1): `inicio_ppm` y `fin_ppm` son el TRAMO de la zona, y son los
// que sitúan la banda en el eje. **No hay ningun nivel 0-100**, y no es un olvido: el nivel era «el
// techo de la zona dividido por el techo mayor», o sea una barra que no representaba nada
// (auditoria:33), y la especificacion lo prohibe (`doc:298`).
export struct BandaZona {
    nombre: string,
    // El tramo YA ESCRITO y CON SU UNIDAD («hasta 137 ppm», «137 – 152 ppm»). El defecto 4 era
    // enseñar «hasta 114» sin decir de que unidad habla (`doc:299`).
    tramo: string,
    inicio_ppm: float,
    fin_ppm: float,
}

// ---- Las piezas que se repiten, declaradas UNA vez (AU-41: una accion, una forma) ----

// Una tarjeta de cifra: el numero CENTRADO y su etiqueta debajo, tambien centrada (§3.5).
//
// QUE ARREGLA, y es el defecto 6 de la auditoria: el numero salia a la IZQUIERDA dentro de una
// tarjeta ancha, y el dueño las vio como «botones mal centrados». Aqui no se alinea nada a la
// izquierda: lo unico que hay en la tarjeta se centra.
//
// Y EL ALTO (66) NO SE TOCA: hay una prueba que localiza las tarjetas **por su alto** (`§3.5`,
// `medir-interfaz.rs`), asi que cambiarlo dejaria ese portero ciego.
component Tarjeta inherits Rectangle {
    in property <string> numero;
    in property <string> etiqueta;
    // El indice que ocupa entre las que EXISTEN: es lo que permite nombrarla para medirla.
    in property <int> indice: 0;
    in property <bool> oscuro: false;
    // El acento SOLO en las que el cliente mira primero (§3.5).
    in property <bool> destacada: false;

    height: 66px;
    border-radius: Medidas.radio;
    background: root.oscuro ? Oscuro.sup : Claro.sup;
    border-width: 1px;
    // El borde DELIMITA, no enmarca: en el boceto apenas se insinua. Con 1 px basta.
    border-color: (root.oscuro ? Oscuro.linea : Claro.linea).with-alpha(0.45);
    // Un papel de accesibilidad es lo que permite NOMBRAR y MEDIR la tarjeta (AU-63). Es `image`
    // porque es una caja que se mide, como la pildora de la barra.
    accessible-role: image;
    accessible-id: "tarjeta-" + root.indice;

    VerticalLayout {
        // EL RELLENO VERTICAL ES 8 Y NO 12, Y ESTA MEDIDO: con 12, lo que la tarjeta tiene que
        // enseñar (numero de 22 = caja de 30, hueco de 3, etiqueta de 12 = caja de 17) pide
        // 12 + 30 + 3 + 17 + 12 = **74** dentro de una tarjeta de **66** (§3.5): la etiqueta se salia
        // por debajo del borde. Con 8 la cuenta da **66 exactos**: 8 + 30 + 3 + 17 + 8. El ALTO y el
        // NUMERO no se tocan (los manda la especificacion y hay un portero que los cuenta); lo que
        // cede es el aire, que es lo unico que no miente si falta. Lo vigila
        // `la_tarjeta_de_cifra_ensena_su_numero_y_su_etiqueta_DENTRO_de_los_66`.
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 3px;
        Text {
            text: root.numero;
            // 22 (title-large) Y NO 26: lo manda la especificacion (§3.5), y con el alto de la
            // tarjeta sin tocar.
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
            // El acento SOLO en las dos primeras: son las que el cliente mira.
            color: root.destacada ? (root.oscuro ? Oscuro.ac : Claro.ac)
                                  : (root.oscuro ? Oscuro.fg : Claro.fg);
        }
        Text {
            text: root.etiqueta;
            font-size: 12px;
            horizontal-alignment: center;
            color: root.oscuro ? Oscuro.muted : Claro.muted;
        }
    }
}

// Una zona: el nombre, su tramo, y SU BANDA SOBRE EL EJE COMUN (§3.6).
//
// EL ALTO DE LA FILA (40) NO SE TOCA: la prueba de los vacios localiza las filas de zona por su
// altura (AU-91), asi que un alto distinto deja ese portero ciego.
component Zona inherits Rectangle {
    in property <string> nombre;
    in property <string> tramo;
    // EL TRAMO, en pulsaciones (contrato 1). Son los dos numeros que sitúan la banda.
    in property <float> inicio_ppm;
    in property <float> fin_ppm;
    // EL EJE COMUN, tambien en pulsaciones (contrato 3): la escala de la que cuelgan las cinco.
    in property <float> eje_inicio_ppm: 0;
    in property <float> eje_fin_ppm: 0;
    in property <int> indice: 0;
    in property <color> tono;
    in property <bool> oscuro: false;
    // La pista: el mismo color, muy suave. **No gris**, porque el gris iguala las cinco zonas.
    in property <color> pista_zona: transparent;

    height: 40px;
    background: transparent;

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text {
                text: root.nombre; font-size: 12px;
                color: root.oscuro ? Oscuro.muted : Claro.muted;
                horizontal-stretch: 1;
            }
            Text {
                text: root.tramo; font-size: 12px;
                color: root.oscuro ? Oscuro.fg : Claro.fg;
            }
        }
        // LA PISTA ES EL EJE ENTERO -- por eso todas las pistas miden lo mismo y se pueden comparar
        // de un vistazo --, y LA BANDA VA DENTRO, EN SU SITIO DEL EJE.
        Rectangle {
            height: 10px;
            border-radius: 5px;
            background: root.pista_zona;
            // La pista se puede MEDIR: es contra su caja (el eje entero) contra lo que se comprueba
            // que la banda cae en su sitio (AU-63).
            accessible-role: image;
            accessible-id: "pista-" + root.indice;
            Rectangle {
                // LA BANDA: del inicio al fin del tramo, EN SU SITIO.
                //
                // ESTA ES LA UNICA CUENTA DEL FICHERO, y hay que decir por que no rompe la regla de
                // «aqui no se calcula nada»: **no es un dato, es un cambio de unidades**. Los cuatro
                // numeros que la mandan (`inicio_ppm`, `fin_ppm`, `eje_inicio_ppm`, `eje_fin_ppm`)
                // vienen del motor; lo unico que se hace aqui es pasar de pulsaciones a pixeles, que
                // es lo que significa dibujar. Un dato nuevo NO puede salir de esta linea: si el
                // motor dijera otro tramo, la banda se moveria sola.
                x: (root.inicio_ppm - root.eje_inicio_ppm) * parent.width
                    / (root.eje_fin_ppm - root.eje_inicio_ppm);
                width: (root.fin_ppm - root.inicio_ppm) * parent.width
                    / (root.eje_fin_ppm - root.eje_inicio_ppm);
                height: parent.height;
                border-radius: 5px;
                background: root.tono;
                // La banda se puede MEDIR por su nombre: sin nombre, la prueba dependeria de un
                // tamano casual (AU-63).
                accessible-role: image;
                accessible-id: "banda-" + root.indice;
            }
        }
    }
}

// Una linea de aviso: el ICONO del catalogo, y UNA frase. Ni un parrafo ni una explicacion.
//
// QUE ARREGLA: el punto de hoy era **un circulo de color de 10 px** (§3.7), y el circulo de color no
// dice nada -- la especificacion pide un icono REAL del catalogo de 192 (AU-90).
component Aviso inherits Rectangle {
    in property <string> texto;
    // El icono es DATO, no decoracion: lo elige quien conoce el mensaje. Su nombre tiene que existir
    // en `iconos.slint`, y lo vigila el portero de iconos.
    in property <string> icono: "informacion";
    in property <bool> oscuro: false;
    height: 44px;
    border-radius: Medidas.radio;
    background: root.oscuro ? Oscuro.pista : Claro.pista;
    // La linea entera se puede medir por su nombre (AU-63).
    accessible-role: image;
    accessible-id: "aviso";
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            // 24, como los iconos de la barra: es la medida del catalogo en la pantalla.
            Icono {
                nombre: root.icono;
                tamano: 24px;
                tono: root.oscuro ? Oscuro.muted : Claro.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                accessible-role: text;
                accessible-id: "aviso-texto";
                text: root.texto; font-size: 12px;
                color: root.oscuro ? Oscuro.fg : Claro.fg;
                // UNA LINEA (AU-44/AU-45: la pantalla no se explica): el texto que llega ya es UNA
                // frase -- la recorta el motor (`precision_corta`, `que_falta_corto`, contrato 4 y 5)
                // --, y aqui se deja partir antes que recortarla: **una frase cortada por la mitad
                // seria peor que una frase en dos lineas**. Se comprueba midiendo: el bloque mide 44
                // y el texto no se sale de el.
                wrap: word-wrap;
            }
        }
    }
}

// ---- EL AIRE LATERAL DE LA PANTALLA, Y LO LLEVA CADA BLOQUE (doc:180, enmienda §3.3) ----
//
// POR QUE NO LO PONE EL ARMAZON, y esta MEDIDO (2026-10-14): con un `padding` en el layout que esta
// DENTRO del `ScrollView`, el contenido se mide a 411 + 2·16 = **443** donde **caben 411**, el
// `ScrollView` concluye que hay algo que desplazar **a lo ancho** y **pinta su barra**: una linea gris
// de 370 px pegada al borde de abajo del contenido (y ≈ 794, `#898887`). Esta escrito en
// `armazon.slint:219-234` y en `SLINT-lo-que-hay-que-saber.md` (§11.3, trampa «c»), y la prueba
// `el_armazon_no_pone_el_margen_dentro_de_lo_que_se_desplaza` vigila que no vuelva.
//
// ASI QUE EL 16 LO PONE CADA BLOQUE, y el patron se escribe UNA vez, con nombre (AU-41: una accion,
// una forma). El VALOR sigue viviendo en UN sitio, `Medidas.margen` (AU-67).
//
// Y NO ES UN `padding`, SON DOS HUECOS. **Medido el 2026-10-14, y es la trampa otra vez, un piso mas
// abajo**: un `padding` en CUALQUIER layout de dentro del `ScrollView` -- no solo en el del armazon,
// TAMBIEN en el envoltorio de cada bloque -- hace que el contenido se mida a **443** donde caben
// **411** y el `ScrollView` pinte su barra horizontal: **740 px de `#898887` en y = 794..795** (370 de
// ancho, dos filas), medidos en `datos/capturas/fase1.png`. Con ese `padding` quitado, la misma franja
// sale `#FAF9F7` limpia. Por eso el aire son dos `Rectangle` de ancho FIJO (`Medidas.margen`) que NO
// declaran relleno: un hueco OCUPA sitio; un relleno cambia lo que mide su contenedor.
//
// EL `VerticalLayout` DE DENTRO ES LO QUE HACE QUE EL BLOQUE SEA UN BLOQUE: ahi dentro el hijo se
// estira al ancho que QUEDA (411 − 2·16 = **379**), que es exactamente lo que hacia el contenido antes
// de esto. Y tiene que ser un LAYOUT: `padding` en un `Rectangle` no hace nada -- Slint avisa
// «padding only has effect on layout elements» --, y por eso el aire no puede ir en la tarjeta misma.
//
// LO QUE ESTE BLOQUE NO HACE: no pone margen ARRIBA ni ABAJO. El hueco entre bloques es del armazon
// (`Medidas.hueco_bloques`, 14) y anadir 16 a cada lado lo dejaria en 46.
component Bloque inherits HorizontalLayout {
    Rectangle { width: Medidas.margen; }      // el aire de la izquierda: un HUECO, no un relleno
    VerticalLayout {
        horizontal-stretch: 1;                // el bloque se queda con lo que sobra del ancho
        @children
    }
    Rectangle { width: Medidas.margen; }      // y el de la derecha
}

// EL COMPONENTE RAIZ elige el armazon segun el espacio. NO pregunta por el dispositivo:
// pregunta por el ANCHO, que es lo unico que importa -- **una ventana de escritorio estrecha es un
// movil a efectos de reparto.**
component Contenido inherits VerticalLayout {
    in property <bool> oscuro: false;
    // LO QUE EL MOTOR ENTREGA (Fase 2). Ya NO hay `cifras` + `etiquetas` ni `zonas_nombres` +
    // `zonas_tramos` + `zonas_niveles`: eran listas paralelas (AU-73) y llevaban dentro lo que
    // justamente habia que quitar -- el guion de las cifras que no existen y el nivel 0-100 de las
    // barras. Ahora cada dato viaja con lo suyo, y lo que no existe no llega.
    in property <[TarjetaCifra]> tarjetas;
    in property <[BandaZona]> bandas;          // las cinco zonas, EN PULSACIONES
    in property <float> eje_inicio_ppm: 0;     // el rango del eje (contrato 3)
    in property <float> eje_fin_ppm: 0;
    in property <string> eje_inicio_texto;     // y el mismo rango, ya escrito, para que se lea
    in property <string> eje_fin_texto;
    in property <bool> eje_valido: false;      // `Eje::es_valido()`, decidido por el motor
    in property <string> precision_corta;      // §3.7: UNA frase (el parrafo va a la ayuda)
    in property <string> que_falta_corto;      // §3.7: UNA frase, y vacia si no falta nada
    in property <string> aviso;
    in property <string> vacio;
    in property <string> periodo;
    // ¿Se puede diagnosticar? Si no, NO se dibujan cifras ni el grafico: serian tarjetas vacias, que
    // es un hueco olvidado (AU-07) y un dato de nadie con aspecto de dato (AU-24).
    in property <bool> puede: false;

    spacing: 12px;

    // ---- §3.5 · LAS TARJETAS, Y SOLO LAS QUE EXISTEN ----
    //
    // `tarjetas` trae SOLO las cifras que el motor tiene (`dato: Some`): la que no existe no ha
    // llegado hasta aqui, asi que **no puede estar en el arbol** (AU-91). Antes la vista recibia
    // cuatro cadenas con un «—» dentro y dibujaba el marco igual: el defecto 5 de la auditoria.
    //
    // LA REGLA DE COMPOSICION (§3.5), y se cumple caso a caso:
    //   · 4 -> dos filas de dos;
    //   · 3 -> dos arriba y la tercera **en la columna de la IZQUIERDA**, con un hueco del mismo
    //          tamano a su derecha, para que la rejilla no baile;
    //   · 2 -> una fila de dos;
    //   · 1 -> una fila con la tarjeta **CENTRADA** (los dos huecos de los lados, del mismo tamano
    //          que ella): una tarjeta sola pegada a la izquierda parece un boton mal puesto, que es
    //          exactamente lo que el dueño vio.
    if root.puede && root.tarjetas.length > 0 : Bloque {
        HorizontalLayout {
            spacing: 12px;
            if root.tarjetas.length == 1 : Rectangle { horizontal-stretch: 1; }
            Tarjeta {
                horizontal-stretch: root.tarjetas.length == 1 ? 2 : 1;
                numero: root.tarjetas[0].numero; etiqueta: root.tarjetas[0].etiqueta;
                indice: 0; destacada: true; oscuro: root.oscuro;
            }
            if root.tarjetas.length >= 2 : Tarjeta {
                horizontal-stretch: 1;
                numero: root.tarjetas[1].numero; etiqueta: root.tarjetas[1].etiqueta;
                indice: 1; destacada: true; oscuro: root.oscuro;
            }
            if root.tarjetas.length == 1 : Rectangle { horizontal-stretch: 1; }
        }
    }
    if root.puede && root.tarjetas.length > 2 : Bloque {
        HorizontalLayout {
            spacing: 12px;
            Tarjeta {
                horizontal-stretch: 1;
                numero: root.tarjetas[2].numero; etiqueta: root.tarjetas[2].etiqueta;
                indice: 2; oscuro: root.oscuro;
            }
            if root.tarjetas.length == 3 : Rectangle { horizontal-stretch: 1; }
            if root.tarjetas.length >= 4 : Tarjeta {
                horizontal-stretch: 1;
                numero: root.tarjetas[3].numero; etiqueta: root.tarjetas[3].etiqueta;
                indice: 3; oscuro: root.oscuro;
            }
        }
    }

    // ---- §3.6 · EL GRAFICO: LAS BANDAS SOBRE EL EJE, EN PULSACIONES ----
    //
    // LO QUE ESTABA MAL, y es el fallo de fondo: el ancho de la barra era **el techo de la zona
    // dividido por el techo mayor** (67 %..100 %), y eso no representa nada (auditoria:33). Lo que se
    // pinta ahora es el TRAMO: cada banda empieza y acaba donde dice el motor, sobre UN eje comun en
    // ppm, con la unidad escrita.
    //
    // CUANDO NO SE DIBUJA (§3.6): sin zonas, o con un eje que no vale -- y quien lo decide es el
    // motor (`Eje::es_valido`), no la vista. Tampoco sin poder diagnosticar: entonces no hay ni
    // grafico ni su marco, y queda la linea de lo que falta.
    if root.puede && root.eje_valido && root.bandas.length > 0 : Bloque {
        Rectangle {
            // EL ALTO ES EL QUE PIDA EL CONTENIDO (§3.6): con el eje deja de ser un numero fijo.
            height: self.preferred-height;
            border-radius: Medidas.radio;
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            border-width: 1px;
            border-color: root.oscuro ? Oscuro.linea : Claro.linea;
            // El grafico entero se puede MEDIR: es lo que permite comprobar que **sin zonas no hay ni
            // grafico ni su marco** (§3.6), en vez de suponerlo.
            accessible-role: image;
            accessible-id: "grafico";
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                Text {
                    text: "Zonas de entrenamiento";
                    font-size: 14px; font-weight: 700;
                    color: root.oscuro ? Oscuro.fg : Claro.fg;
                }
                // EL EJE, y el eje es el MISMO para las cinco bandas: es lo que permite compararlas.
                // De la minima a la maxima de las cinco zonas (contrato 3), con la unidad escrita
                // (defecto 4). Los dos numeros los formatea el motor: aqui no se calcula.
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        Text {
                            accessible-role: text; accessible-id: "eje-inicio";
                            text: root.eje_inicio_texto; font-size: 12px;
                            color: root.oscuro ? Oscuro.muted : Claro.muted;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            accessible-role: text; accessible-id: "eje-fin";
                            text: root.eje_fin_texto; font-size: 12px;
                            color: root.oscuro ? Oscuro.muted : Claro.muted;
                        }
                    }
                    Text {
                        accessible-role: text; accessible-id: "eje-unidad";
                        text: "ppm"; font-size: 12px; horizontal-alignment: center;
                        color: root.oscuro ? Oscuro.muted : Claro.muted;
                    }
                }
                for b[i] in root.bandas : Zona {
                    nombre: b.nombre;
                    tramo: b.tramo;
                    inicio_ppm: b.inicio_ppm; fin_ppm: b.fin_ppm;
                    eje_inicio_ppm: root.eje_inicio_ppm; eje_fin_ppm: root.eje_fin_ppm;
                    indice: i;
                    oscuro: root.oscuro;
                    tono: i == 0 ? (root.oscuro ? Oscuro.z1 : Claro.z1)
                        : i == 1 ? (root.oscuro ? Oscuro.z2 : Claro.z2)
                        : i == 2 ? (root.oscuro ? Oscuro.z3 : Claro.z3)
                        : i == 3 ? (root.oscuro ? Oscuro.z4 : Claro.z4)
                                 : (root.oscuro ? Oscuro.z5 : Claro.z5);
                    // La pista, del mismo color pero muy suave: se VE que la banda es de esa zona.
                    pista_zona: (i == 0 ? (root.oscuro ? Oscuro.z1 : Claro.z1)
                        : i == 1 ? (root.oscuro ? Oscuro.z2 : Claro.z2)
                        : i == 2 ? (root.oscuro ? Oscuro.z3 : Claro.z3)
                        : i == 3 ? (root.oscuro ? Oscuro.z4 : Claro.z4)
                                 : (root.oscuro ? Oscuro.z5 : Claro.z5)).with-alpha(0.18);
                }
            }
        }
    }
    // ---- §3.7 · LO QUE FALTA, EN UNA LINEA CON SU ICONO ----
    //
    // Cuando NO se puede diagnosticar, el Resumen dice **que falta y donde se rellena**, en UNA frase
    // (`que_falta_corto`, contrato 5). El parrafo de dos frases que habia antes (`que_falta`) se
    // queda en el motor, para la ayuda, que es donde AU-44/AU-45 lo mandan.
    if !root.puede && root.que_falta_corto != "" : Bloque {
        Aviso { icono: "aviso"; texto: root.que_falta_corto; oscuro: root.oscuro; }
    }
    // ---- §3.7 · LA PRECISION, EN UNA LINEA CON SU ICONO ----
    //
    // El texto de pantalla es `precision_corta` (contrato 4): UNA frase. El parrafo entero se queda
    // en el motor (`precision`) para la AYUDA. Y si esta vacio, el bloque NO existe (AU-07): hoy ya
    // era asi y se conserva.
    if root.puede && root.precision_corta != "" : Bloque {
        Aviso { icono: "informacion"; texto: root.precision_corta; oscuro: root.oscuro; }
    }
    // EL PERIODO Y EL RECUENTO, en la misma tarjeta de alto FIJO: son las dos cosas que dicen «que
    // datos hay», y asi la linea del periodo no absorbe el hueco sobrante del reparto (medido: 116 px
    // de celda cuando iba suelta, con un vacio de 98 px debajo). El periodo lo escribe Rust (`cara`),
    // en UNA linea; aqui NO se calcula. Y va CONDICIONAL: sin fechas no se dibuja el hueco (AU-07).
    Bloque {
        Rectangle {
            height: 52px;
            border-radius: Medidas.radio;
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            border-width: 1px;
            border-color: root.oscuro ? Oscuro.linea : Claro.linea;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: center;
                spacing: 2px;
                if root.periodo != "" : Text {
                    // El nombre de accesibilidad es lo unico que permite MEDIRLO desde una prueba (AU-63).
                    accessible-role: text;
                    accessible-id: "periodo";
                    text: root.periodo; font-size: 12px;
                    color: root.oscuro ? Oscuro.muted : Claro.muted;
                    wrap: word-wrap;
                }
                Text {
                    // 12 Y NO 13, Y LO MANDA LA ESPECIFICACION (§3.8: «el recuento: 12 px (era 13: se
                    // corrige a label)»). Era la incoherencia que quedaba abierta, y estaba A LA VISTA:
                    // **medido el 2026-10-14 con los datos reales**, a 13 px este texto («102 sesiones ·
                    // 549842 lecturas · 1259082 intervalos de HRV») parte en DOS lineas de 18 px, y la
                    // tarjeta tiene **52 de alto FIJO** (§3.8), asi que la segunda linea se salia por
                    // debajo del borde: en la captura se veia «HRV» fuera de la tarjeta. A 12 px cabe en
                    // UNA linea y el texto entra dentro de los 52. Lo vigila
                    // `el_recuento_del_periodo_cabe_en_el_alto_52_de_la_tarjeta`.
                    text: root.vacio; font-size: 12px;
                    color: root.oscuro ? Oscuro.muted : Claro.muted;
                    // Y ESTA LINEA TIENE QUE PODER PARTIRSE, y no es un adorno: es lo que hace que el
                    // margen de 16 sea POSIBLE. Medido el 2026-10-14: sin `wrap`, este texto (que es el
                    // mas largo de la pantalla, «102 sesiones · 549842 lecturas · …») mide el ancho
                    // ENTERO de la ventana, asi que el bloque no puede encoger NI UN PIXEL: en cuanto el
                    // contenido se mete 16 hacia dentro, el bloque se sale, el contenido se mide a 443
                    // donde caben 411 y el `ScrollView` **pinta su barra horizontal** (740 px de
                    // `#898887` en y = 794..795). El margen no se veia porque el texto no dejaba.
                    wrap: word-wrap;
                }
            }
        }
    }
    // El aviso de lo que se deduce del aparato (la deriva), tambien en UNA linea con su icono. El
    // icono es el reloj porque habla de sesiones, que es lo que se mide en el tiempo.
    if root.aviso != "" : Bloque {
        Aviso { icono: "reloj"; texto: root.aviso; oscuro: root.oscuro; }
    }
}

// ================================================================================================
// LA SECCION «DATOS»: los datos de la persona, y **son suyos**.
// ================================================================================================
//
// POR QUE ES LA SECCION QUE MAS IMPORTA: hasta hoy los datos de la persona estaban **escritos en el
// codigo**, asi que los resultados que enseñaba la pantalla **no eran del cliente, eran de quien
// compilo el programa** -- y eso no se veia: los numeros tenian buena cara.
//
// Y AQUI NO HAY `Slider` NI `SpinBox`, que seria lo comodo: un deslizador obliga a fijar un MINIMO y
// un MAXIMO, y **ese rango seria una decision inventada** sobre el cuerpo de una persona. Se usan
// campos de texto, y decide el motor: el que escriba «900» vera que el motor no lo acepta.

// UN CAMPO: la etiqueta, y el control de serie DENTRO de un marco nuestro.
//
// POR QUE EL MARCO, y esta medido de la fuente del estilo: en el tema negro el borde del campo es
// blanco al 8 % sobre negro (**~1,1:1**, minimo 3:1) y su relleno es blanco al 6 %, o sea que **el
// campo no se ve**: solo se ve lo que se escribe dentro. El contorno lo pone un `Rectangle` NUESTRO
// por fuera -- la salida que ya esta probada en `sonda-borde.slint`, donde se comprobo que el marco
// no recorta al control si el hueco lo pone el `padding` del layout.
component Campo inherits VerticalLayout {
    in property <string> etiqueta;
    // `accessible-id` es la forma OFICIAL de encontrar un elemento desde las pruebas, y **exige un
    // papel de accesibilidad**: el del `LineEdit` ya viene puesto por el estilo, y la prueba lo
    // comprueba.
    in property <string> identificador;
    in property <string> pista;
    in-out property <string> texto;
    in property <bool> oscuro: false;

    spacing: 3px;
    Text {
        text: root.etiqueta;
        font-size: 11px;
        color: root.oscuro ? Oscuro.muted : Claro.muted;
    }
    Rectangle {
        border-width: 1px;
        border-color: root.oscuro ? Oscuro.linea : Claro.linea;
        border-radius: Medidas.radio;
        // La altura se le PIDE AL HIJO. Calcularla con `self.preferred-height + 4px` fue el fallo que
        // se cazo midiendo en la sonda: el marco salia de 4 px de alto y el control se salia.
        height: self.preferred-height;
        VerticalLayout {
            padding: 2px;
            LineEdit {
                accessible-id: root.identificador;
                text <=> root.texto;
                placeholder-text: root.pista;
                // El minimo tactil del proyecto son 48 dp y el estilo trae 32: **hay que pedirlo**.
                // Con `max()` y no con un 48 fijo: asi, el dia que el texto necesite mas alto, el
                // campo crece en vez de recortarlo.
                height: max(48px, self.preferred-height);
            }
        }
    }
}

component Datos inherits VerticalLayout {
    in-out property <DatosPersona> campos;
    in-out property <bool> oscuro: false;
    in property <string> mensaje;
    in property <bool> error: false;
    in property <string> ruta;
    // ---- GARMIN: el estado, la via, si esta trabajando, y lo que trajo (HITO C) ----
    //
    // SON CUATRO CAMPOS Y NO UNO SOLO CON EL TEXTO YA MONTADO: la pantalla NO formatea numeros de
    // significado (solo el motor decide que se enseña). `garmin_resumen` llega **ya escrito** por
    // `cara::texto_del_resumen`, y los otros tres son estado, no texto: el icono del estado y el
    // apagado del boton se deciden aqui a partir de un `bool`, no de una cadena que habria que
    // interpretar (AU-88: leer un simbolo es donde la pantalla empieza a mentir).
    in property <bool> garmin_conectado: false;
    // Vacio = no se sabe por donde; «SSO web» o «movil DI» cuando se sabe.
    in property <string> garmin_via;
    in property <bool> garmin_sincronizando: false;
    // UNA linea ya escrita por el motor, o vacio (y entonces no se dibuja).
    in property <string> garmin_resumen;
    callback guardar;
    // Sincronizar **no sincroniza aqui**: pide. Quien la conecte decide que pasa (hoy puede no hacer
    // nada): la RED queda fuera de la vista y del HITO C.
    callback sincronizar-garmin;
    // Abre la capa del selector. La capa se dibuja en la VENTANA, no aqui: este panel solo pide.
    callback abrir-selector;

    spacing: 10px;

    // CADA FILA CON SU `Bloque`, COMO EN EL RESUMEN, Y AQUI HUBO UN DEFECTO DE VERDAD (2026-10-14):
    // esta seccion se colocaba entera como hija del armazon, **sin envoltorio**, y como el margen
    // lateral lo entrega `Bloque` -- el armazon NO lo pone, porque dentro del `ScrollView` un relleno
    // hace que el `ScrollView` pinte su barra horizontal --, la seccion no tenia margen NINGUNO:
    // **medido, sus textos empezaban en x = 0 y su columna derecha acababa en x = 411**, o sea texto
    // pegado a los DOS bordes de la pantalla. No se habia visto porque solo se medía el PRIMER bloque
    // del Resumen. Lo vigilan `todos_los_bloques_del_contenido_llevan_el_margen_de_16` (AU-95:
    // portero global, no lista) y `ningun_bloque_del_contenido_se_salta_el_envoltorio_bloque`.
    Bloque {
        Text {
            text: "Sus datos";
            font-size: 15px; font-weight: 700;
            color: root.oscuro ? Oscuro.fg : Claro.fg;
        }
    }
    // UNA linea, y dice lo unico que hay que saber antes de escribir: que dejarlo vacio es una
    // respuesta valida y significa «no lo sé».
    Bloque {
        Text {
            text: "Lo que ningún aparato puede saber. Un campo vacío es «no lo sé», no un cero.";
            font-size: 11px;
            wrap: word-wrap;
            color: root.oscuro ? Oscuro.muted : Claro.muted;
        }
    }

    // LOS CAMPOS, en dos columnas: a la izquierda los del corazon y el esfuerzo, a la derecha los de
    // la bascula. Es la agrupacion que el cliente ya usa al hablar de sus datos, y ademas hace que
    // los diez quepan sin desplazar la pantalla.
    Bloque {
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                Campo { etiqueta: "Edad"; identificador: "datos-edad"; pista: "años"; texto <=> root.campos.edad; oscuro: root.oscuro; }
                Campo { etiqueta: "Pulso en reposo"; identificador: "datos-pulso_reposo"; pista: "ppm, durmiendo"; texto <=> root.campos.pulso_reposo; oscuro: root.oscuro; }
                Campo { etiqueta: "Pulso máximo"; identificador: "datos-pulso_maximo_medido"; pista: "ppm, medido"; texto <=> root.campos.pulso_maximo_medido; oscuro: root.oscuro; }
                Campo { etiqueta: "Umbral de lactato"; identificador: "datos-umbral_lactato"; pista: "ppm, de una prueba"; texto <=> root.campos.umbral_lactato; oscuro: root.oscuro; }
                Campo { etiqueta: "VO₂ máximo"; identificador: "datos-vo2_maximo"; pista: "ml/kg/min"; texto <=> root.campos.vo2_maximo; oscuro: root.oscuro; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                Campo { etiqueta: "Peso"; identificador: "datos-peso_kg"; pista: "kg"; texto <=> root.campos.peso_kg; oscuro: root.oscuro; }
                Campo { etiqueta: "Altura"; identificador: "datos-altura_cm"; pista: "cm"; texto <=> root.campos.altura_cm; oscuro: root.oscuro; }
                Campo { etiqueta: "Grasa corporal"; identificador: "datos-grasa_corporal_pct"; pista: "%"; texto <=> root.campos.grasa_corporal_pct; oscuro: root.oscuro; }
                Campo { etiqueta: "Masa muscular"; identificador: "datos-masa_muscular_kg"; pista: "kg"; texto <=> root.campos.masa_muscular_kg; oscuro: root.oscuro; }
            }
        }
    }

    // EL SEXO. Se deja SIN marco a proposito: el circulo del `RadioButton` es blanco al 60 %, que
    // sobre negro da mas de 7:1 -- o sea, aqui el estilo SI dibuja lo que hace falta. Poner un marco
    // donde no falta es ruido.
    // EL SEXO, con un `ComboBox` y NO con un `RadioGroup`.
    //
    // POR QUE, y esta MEDIDO a golpes: el `RadioGroup` de Slint 1.18 **no deja escribir su indice
    // desde fuera** -- `current-index <=> ...` da «Unknown property current-index in RadioGroup»,
    // aunque la propiedad SI existe en el estilo (`radiogroup-base.slint`). Y el mensaje engaña,
    // porque señala a una propiedad que esta.
    //
    // El `ComboBox` si deja: se le da el `model` y se lee y escribe `current-index`. Y para TRES
    // opciones excluyentes es ademas lo que la norma pide: **una accion, una forma**.
    Bloque {
        ComboBox {
            accessible-id: "datos-sexo";
            model: ["No lo sé", "Femenino", "Masculino"];
            current-index: root.campos.sexo;
            // El callback entrega el TEXTO, y nuestro campo es un indice: se traduce aqui, que es donde
            // esta la lista. Traducir en Rust obligaria a que Rust conociera los rotulos de la pantalla.
            selected(t) => {
                root.campos.sexo = t == "Femenino" ? 1 : (t == "Masculino" ? 2 : 0);
            }
        }
    }

    // GUARDAR. El boton va dentro de un marco nuestro por lo mismo que los campos, y esta medido: en
    // el tema negro el borde de serie del boton da **1,14:1** y **no se ve** -- un boton sin contorno,
    // sobre negro, parece un rotulo.
    Bloque {
        Rectangle {
            border-width: 2px;
            border-color: root.oscuro ? Oscuro.linea : Claro.linea;
            border-radius: 8px;
            height: self.preferred-height;
            VerticalLayout {
                // El hueco entre el borde y el boton lo pone el `padding`, no una cuenta.
                padding: 2px;
                Button {
                    accessible-id: "datos-guardar";
                    height: max(48px, self.preferred-height);
                    text: "Guardar mis datos";
                    primary: true;
                    clicked => { root.guardar(); }
                }
            }
        }
    }

    // LO QUE PASO AL GUARDAR, en una linea: o se guardo, o se dice que campo esta mal. **Un numero mal
    // escrito no se traga en silencio**: guardar un cero donde el usuario no escribio nada seria un
    // dato falso con buena cara, que es justo lo que este proyecto no hace.
    Bloque {
        Text {
            accessible-id: "datos-mensaje";
            text: root.mensaje;
            font-size: 12px;
            wrap: word-wrap;
            color: root.error
                ? (root.oscuro ? Oscuro.aviso : Claro.aviso)
                : (root.oscuro ? Oscuro.ok : Claro.ok);
        }
    }

    // DONDE VIVEN SUS DATOS, y no es un detalle: el dueño decidio que el fichero viaje JUNTO AL
    // PROGRAMA, y si no se pudo escribir ahi hay que decirlo, porque el usuario tiene derecho a saber
    // donde estan sus datos.
    Bloque {
        Text {
            accessible-id: "datos-ruta";
            text: root.ruta;
            font-size: 11px;
            wrap: word-wrap;
            color: root.oscuro ? Oscuro.muted : Claro.muted;
        }
    }

    // BUSCAR SUS FICHEROS. Es EL ATAJO QUE MAS VALE: sin cuenta, ni permiso, ni internet, porque sus
    // datos ya estan en su equipo. Abre la capa del selector, que se dibuja sobre la ventana entera.
    Bloque {
        Rectangle {
            border-width: 2px;
            border-color: root.oscuro ? Oscuro.linea : Claro.linea;
            border-radius: 8px;
            height: self.preferred-height;
            VerticalLayout {
                padding: 2px;
                Button {
                    accessible-id: "datos-buscar";
                    height: max(48px, self.preferred-height);
                    text: "Buscar mis ficheros";
                    clicked => { root.abrir-selector(); }
                }
            }
        }
    }

    // EL BLOQUE GARMIN: **conectar, decir por que via, y sincronizar**, en un bloque con su marco.
    //
    // POR QUE VA AQUI Y NO EN UNA SECCION NUEVA: la navegacion de CUATRO esta aprobada y medida
    // (`estado:301-307`), y Garmin es **otra forma de traer los datos de la persona**, que es lo que
    // esta seccion ya hace con «Buscar mis ficheros». Dos formas de traer datos, un solo sitio.
    //
    // Y AQUI NO HAY RED. El boton **no sincroniza**: dispara la callback `sincronizar-garmin` y se
    // para. La pantalla declara lo que el usuario puede pedir; **cuando se llama al flujo de verdad es
    // decision del dueño** (es la integracion del flujo en la aplicacion, la misma decision pendiente
    // que la accion primaria). Si aqui se llamara al motor, la vista tendria red, disco y estado, y
    // esto dejaria de ser una vista.
    Bloque {
        Rectangle {
            // EL MARCO POR FUERA, de 1 px con el token `linea` (§3.11), por el motivo ya medido en los
            // campos y en los botones: en el tema negro el contorno de serie da 1,14:1 y **no se ve**.
            border-width: 1px;
            border-color: root.oscuro ? Oscuro.linea : Claro.linea;
            border-radius: Medidas.radio;
            // EL BLOQUE ENTERO CON NOMBRE (AU-63): sin nombre, «el marco tiene 1 px, no recorta al
            // boton y ocupa el ancho completo» no se puede comprobar -- y lo que no se mide es justo
            // lo que se rompe sin que nadie lo vea.
            accessible-role: region;
            accessible-id: "garmin-marco";
            // LA ALTURA SE LE PIDE AL HIJO. Calcularla con `self.preferred-height` del envoltorio es
            // el fallo ya medido (marco de 4 px de alto con el control saliendose).
            height: self.preferred-height;
            VerticalLayout {
                // El hueco del marco lo pone el `padding` del layout (§3.11), no una cuenta.
                padding: 12px;
                spacing: 8px;

                // (a0) EL TITULO DEL BLOQUE: 14 (body) 700, como pide §3.11.
                Text {
                    accessible-role: text;
                    accessible-id: "garmin-titulo";
                    text: "Garmin";
                    font-size: 14px; font-weight: 700;
                    color: root.oscuro ? Oscuro.fg : Claro.fg;
                }

                // (a) EL ESTADO: «Conectado» o «No conectado», **con su icono del catalogo**. Los dos
                // nombres existen en `iconos.slint` y no se inventa ninguno: el portero de iconos
                // vigila que todo nombre usado este en el catalogo de 192.
                HorizontalLayout {
                    height: 44px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icono {
                            nombre: root.garmin_conectado ? "ok-circulo" : "informacion";
                            tamano: 24px;
                            tono: root.oscuro
                                ? (root.garmin_conectado ? Oscuro.ok : Oscuro.muted)
                                : (root.garmin_conectado ? Claro.ok : Claro.muted);
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            accessible-role: text;
                            accessible-id: "garmin-estado";
                            text: root.garmin_conectado ? "Conectado" : "No conectado";
                            font-size: 12px;
                            color: root.oscuro ? Oscuro.fg : Claro.fg;
                        }
                    }
                }

                // (b) LA VIA, **y solo si hay via** (AU-91: un vacio no se dibuja, ni su marco). La
                // cadena vacia es «no se sabe por donde», y eso no se escribe: no hay nada que leer.
                if root.garmin_via != "" : HorizontalLayout {
                    height: 44px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icono { nombre: "enlace"; tamano: 24px; tono: root.oscuro ? Oscuro.muted : Claro.muted; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            accessible-role: text;
                            accessible-id: "garmin-via";
                            text: root.garmin_via;
                            font-size: 12px;
                            color: root.oscuro ? Oscuro.muted : Claro.muted;
                        }
                    }
                }

                // (c) SINCRONIZAR: es EL CONTROL del bloque, con marco por fuera, `padding` 2 y **48 de
                // alto** (§3.11: el estilo trae 32 y el minimo del proyecto son 48). Mientras
                // `garmin_sincronizando` sea cierto el boton se apaga y lo dice: **un boton que se
                // puede volver a pulsar mientras trabaja es una segunda sincronizacion**.
                Rectangle {
                    border-width: 1px;
                    border-color: root.oscuro ? Oscuro.linea : Claro.linea;
                    border-radius: 8px;
                    height: self.preferred-height;
                    VerticalLayout {
                        padding: 2px;
                        Button {
                            accessible-id: "garmin-sincronizar";
                            height: max(48px, self.preferred-height);
                            text: root.garmin_sincronizando ? "Sincronizando..." : "Sincronizar";
                            enabled: !root.garmin_sincronizando;
                            clicked => { root.sincronizar-garmin(); }
                        }
                    }
                }

                // (d) LO QUE TRAJO LA SINCRONIZACION, **en UNA linea y con su icono** (§3.7, AU-92), y
                // **no se dibuja si esta vacia** (AU-91): sin sincronizar todavia no hay nada que
                // decir, y una linea hueca con su icono diria que si lo hay. La frase la escribe el
                // motor (`cara::texto_del_resumen`) y nunca enumera fechas: la pantalla no se explica.
                if root.garmin_resumen != "" : HorizontalLayout {
                    height: 44px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icono { nombre: "nube-bajada"; tamano: 24px; tono: root.oscuro ? Oscuro.muted : Claro.muted; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            accessible-role: text;
                            accessible-id: "garmin-resumen";
                            text: root.garmin_resumen;
                            font-size: 12px;
                            color: root.oscuro ? Oscuro.fg : Claro.fg;
                        }
                    }
                }
            }
        }
    }

    // EL TEMA. Manda SIEMPRE el nuestro, nunca el del sistema (ver `Palette` en la raiz), y este es
    // el mando: cambiar de tema es cambiar UNA propiedad.
    Bloque {
        Switch {
            accessible-id: "datos-tema";
            checked <=> root.oscuro;
            text: "Tema oscuro";
        }
    }
}

export component Ventana inherits Window {
    // LOS NOMBRES DE LOS SITIOS, para poder MEDIRLOS desde las pruebas (AU-63).
    // No son decorativos: sin un nombre, un elemento no se puede consultar ni medir.
    // Lo que el motor entrega. TODO son cadenas y numeros YA DECIDIDOS: la ventana NO formatea
    // numeros de significado ni calcula nada (solo el motor decide que se enseña).
    in property <[TarjetaCifra]> tarjetas;
    in property <[BandaZona]> bandas;
    in property <float> eje_inicio_ppm: 0;
    in property <float> eje_fin_ppm: 0;
    in property <string> eje_inicio_texto;
    in property <string> eje_fin_texto;
    in property <bool> eje_valido: false;
    in property <string> precision_corta;
    in property <string> que_falta_corto;
    in property <string> aviso;
    in property <string> vacio;
    in property <string> periodo;
    in property <bool> puede: false;
    // EL TEMA. Cambiar de tema es cambiar ESTA linea: ninguna pieza se toca (AU-39).
    // Es `in-out` y no `in` porque el mando del tema vive DENTRO de la pantalla (el `Switch` de la
    // seccion «Datos»): un `in` solo lo puede escribir quien crea la ventana, y el usuario no es ese.
    in-out property <bool> oscuro: false;

    // LA SECCION ELEGIDA, y lo que decide que se enseña. Es estado de la pantalla, no del motor.
    in-out property <int> seccion_activa: 0;

    // LOS DATOS DE LA PERSONA, tal como estan en los campos. Arrancan VACIOS y con «no lo sé» en el
    // sexo: antes de que Rust lea el perfil, la pantalla no puede enseñar un dato que no tiene.
    in-out property <DatosPersona> campos: {
        edad: "", pulso_reposo: "", pulso_maximo_medido: "", peso_kg: "", altura_cm: "",
        grasa_corporal_pct: "", masa_muscular_kg: "", umbral_lactato: "", vo2_maximo: "", sexo: 2,
    };
    // Lo que paso al guardar, y donde quedaron los datos.
    in property <string> mensaje_guardado;
    in property <bool> error_al_guardar: false;
    in property <string> ruta_del_perfil;

    // ---- GARMIN (HITO C): el mismo contrato de cuatro campos que lee la seccion «Datos» ----
    //
    // Son `in` y no `in-out` porque **quien las escribe es Rust**: el estado de la conexion es del
    // motor (lo sabe quien habla con Garmin), no de la pantalla. Lo `in-out` de esta ventana es lo que
    // el USUARIO cambia con el dedo (el tema, la seccion, los campos, el selector).
    in property <bool> garmin_conectado: false;
    in property <string> garmin_via;
    in property <bool> garmin_sincronizando: false;
    in property <string> garmin_resumen;
    // EL BOTON PIDE, NO HACE, y por eso esta callback se declara **SIN CONECTAR a proposito**:
    // integrar el flujo de sincronizacion en la aplicacion es decision del dueño (como la accion
    // primaria). Mientras no se conecte, pulsar «Sincronizar» no hace nada, y no es un olvido: es que
    // **la RED queda fuera** de este hito.
    callback sincronizar-garmin;

    // ---- EL SELECTOR DE CARPETA: la capa que se superpone para elegir donde estan sus ficheros ----
    // Todo lo de abajo lo calcula Rust con `carpeta::abrir`. Aqui solo se dibuja.
    in-out property <bool> eligiendo: false;
    in property <string> carpeta_ruta;
    in property <int> carpeta_fit: 0;
    in property <bool> carpeta_puede_subir: false;
    in property <string> carpeta_aviso;
    in property <[EntradaCarpeta]> carpetas;
    callback abrir-selector;
    callback cerrar-selector;
    callback subir-carpeta;
    callback usar-carpeta;
    callback elegir-subcarpeta(int);

    // PARA MEDIR EL TEMA DE LOS CONTROLES DE SERIE DESDE UNA PRUEBA: no hay otra forma de consultar
    // un global de Slint desde Rust, y esta linea es la que demuestra que el esquema sigue a nuestro
    // tema en vez de al del sistema.
    out property <bool> controles_en_oscuro: Palette.color-scheme == ColorScheme.dark;

    // FASE 1: SE INTENTO dejar esto como BINDING, que es lo que pide AU-84 (doc:131, doc:396), y
    // **no compila**, y las dos formas se probaron:
    //   1. `Palette.color-scheme: ...;` en el cuerpo  -> «Parse error» (un global NO se puede
    //      enlazar asi; Slint solo admite `Global.prop = valor;` imperativo).
    //   2. `propiedad <=> Palette.color-scheme;`      -> «Duplicated property binding» (el sistema
    //      intentaria escribir en la nuestra).
    // Lo que SI hace reactivo a `oscuro` es un manejador de cambio, y no un `init`: el `init` corre
    // UNA vez, y el dia que el tema se cambie en caliente el esquema se quedaria atras.
    changed oscuro => {
        Palette.color-scheme = root.oscuro ? ColorScheme.dark : ColorScheme.light;
    }
    init => { Palette.color-scheme = root.oscuro ? ColorScheme.dark : ColorScheme.light; }

    title: "Pulso";
    // SIN EL MARCO DEL SISTEMA, y no es un capricho: la barra de ventana de arriba **no es parte de
    // la aplicacion**, y en el telefono no existe. Enseñarla en el escritorio hace que la ventana
    // parezca un programa a medio hacer -- y ademas come 30 px de alto.
    no-frame: true;
    // EL TAMANO DE LA VENTANA ES UNA PROPIEDAD, NO UN LITERAL (2026-10-14), y no es para «poder
    // redimensionar»: es para poder **MEDIR EL ARMAZON DE ESCRITORIO** (AU-63). Medido el
    // 2026-10-14: `Window::set_size` (desde Rust) **no cambia la geometria** -- la ventana dice
    // 1280 x 800 y la raiz sigue midiendo 411, porque manda este binding--, asi que con el tamano
    // clavado el armazon de escritorio **no se podia medir de ninguna manera**: `es_movil` era
    // cierto siempre y la rama del riel no llegaba a existir en el arbol. Con la propiedad, la
    // prueba pone 1280 x 800 y mide **la misma rama que usa la aplicacion**.
    // EL VALOR POR DEFECTO ES EL CONTRATO (doc:43, AU-93): `cargo run` sigue abriendo el telefono
    // de 411 x 880, y por eso la ventana sigue siendo de tamano FIJO.
    in-out property <length> ancho_ventana: Medidas.ancho;
    in-out property <length> alto_ventana: Medidas.alto;
    // Las medidas vienen del armazon (AU-67: un valor, un sitio).
    width: root.ancho_ventana;
    height: root.alto_ventana;
    background: root.oscuro ? Oscuro.bg : Claro.bg;

    // La unica decision de reparto: ¿cabe el riel?
    // NO se pregunta por el dispositivo -- se pregunta por el ESPACIO. **Una ventana de escritorio
    // estrecha es un movil a efectos de reparto.**
    property <bool> es_movil: root.width < Medidas.corte;

    // Las secciones, declaradas UNA vez y usadas por los dos armazones (AU-10).
    property <[Seccion]> las_secciones: [
        { nombre: "Resumen", icono: "casa", activa: root.seccion_activa == 0 },
        { nombre: "Zonas", icono: "corazon", activa: root.seccion_activa == 1 },
        { nombre: "Sesiones", icono: "bicicleta", activa: root.seccion_activa == 2 },
        { nombre: "Datos", icono: "ajustes", activa: root.seccion_activa == 3 },
    ];

    callback elegir(int);
    // El armazon avisa de la seccion elegida, y aqui se cambia lo que se enseña. Estaba en Rust y
    // hacia otra cosa: alternaba el tema al pulsar «Datos», que era un apaño mientras no habia mas
    // pantallas. **El tema tiene su propio mando, y este callback hace lo que dice su nombre.**
    elegir(i) => { root.seccion_activa = i; }

    // LA INTERFAZ ENTREGA, RUST GUARDA. Aqui no se valida nada: los textos salen tal cual y es Rust
    // quien los traduce, los comprueba y los escribe en el fichero.
    callback guardar-datos(DatosPersona);



    if root.es_movil : ArmazonMovil {
        // El armazon de movil, medible.
        oscuro: root.oscuro;
        // EL TITULO ES LA SECCION, no el nombre de la app (doc:145, auditoria:39): el top app bar de
        // Android dice DONDE ESTAS. Fase 1: decia «Pulso» y la cabecera no decia nada de la pantalla.
        titulo: root.las_secciones[root.seccion_activa].nombre;
        secciones: root.las_secciones;
        elegir(i) => { root.elegir(i); }
        if root.seccion_activa == 3 : Datos {
            oscuro <=> root.oscuro;
            campos <=> root.campos;
            mensaje: root.mensaje_guardado;
            error: root.error_al_guardar;
            ruta: root.ruta_del_perfil;
            garmin_conectado: root.garmin_conectado;
            garmin_via: root.garmin_via;
            garmin_sincronizando: root.garmin_sincronizando;
            garmin_resumen: root.garmin_resumen;
            guardar => { root.guardar-datos(root.campos); }
            abrir-selector => { root.abrir-selector(); }
            // El armazon de la seccion no decide nada: pasa el aviso hacia arriba, a la ventana, que
            // es donde se conecta (o no) el flujo. Una sola costura para los dos armazones.
            sincronizar-garmin => { root.sincronizar-garmin(); }
        }
        if root.seccion_activa != 3 : Contenido {
            oscuro: root.oscuro;
            tarjetas: root.tarjetas; bandas: root.bandas;
            eje_inicio_ppm: root.eje_inicio_ppm; eje_fin_ppm: root.eje_fin_ppm;
            eje_inicio_texto: root.eje_inicio_texto; eje_fin_texto: root.eje_fin_texto;
            eje_valido: root.eje_valido;
            precision_corta: root.precision_corta; que_falta_corto: root.que_falta_corto;
            aviso: root.aviso; vacio: root.vacio; periodo: root.periodo; puede: root.puede;
        }
    }

    if !root.es_movil : ArmazonEscritorio {
        oscuro: root.oscuro;
        // EL TAMANO DE LA VENTANA, que lo sabe la ventana: el armazon de escritorio OCUPA la ventana
        // (medido: antes medía 411 x 880 y salia centrado dentro de una ventana de 1280).
        ancho_ventana: root.ancho_ventana;
        alto_ventana: root.alto_ventana;
        // Lo mismo en escritorio: el riel escribe la seccion en la que estas (doc:145).
        titulo: root.las_secciones[root.seccion_activa].nombre;
        secciones: root.las_secciones;
        elegir(i) => { root.elegir(i); }
        if root.seccion_activa == 3 : Datos {
            oscuro <=> root.oscuro;
            campos <=> root.campos;
            mensaje: root.mensaje_guardado;
            error: root.error_al_guardar;
            ruta: root.ruta_del_perfil;
            garmin_conectado: root.garmin_conectado;
            garmin_via: root.garmin_via;
            garmin_sincronizando: root.garmin_sincronizando;
            garmin_resumen: root.garmin_resumen;
            guardar => { root.guardar-datos(root.campos); }
            abrir-selector => { root.abrir-selector(); }
            // El armazon de la seccion no decide nada: pasa el aviso hacia arriba, a la ventana, que
            // es donde se conecta (o no) el flujo. Una sola costura para los dos armazones.
            sincronizar-garmin => { root.sincronizar-garmin(); }
        }
        if root.seccion_activa != 3 : Contenido {
            oscuro: root.oscuro;
            tarjetas: root.tarjetas; bandas: root.bandas;
            eje_inicio_ppm: root.eje_inicio_ppm; eje_fin_ppm: root.eje_fin_ppm;
            eje_inicio_texto: root.eje_inicio_texto; eje_fin_texto: root.eje_fin_texto;
            eje_valido: root.eje_valido;
            precision_corta: root.precision_corta; que_falta_corto: root.que_falta_corto;
            aviso: root.aviso; vacio: root.vacio; periodo: root.periodo; puede: root.puede;
        }
    }

    // LA CAPA, DECLARADA LA ULTIMA para quedar POR ENCIMA de los dos armazones.
    if root.eligiendo : SelectorCarpeta {
        oscuro: root.oscuro;
        ruta: root.carpeta_ruta;
        fit_aqui: root.carpeta_fit;
        puede_subir: root.carpeta_puede_subir;
        aviso: root.carpeta_aviso;
        carpetas: root.carpetas;
        subir => { root.subir-carpeta(); }
        usar => { root.usar-carpeta(); }
        elegir(i) => { root.elegir-subcarpeta(i); }
        cerrar => { root.cerrar-selector(); }
    }
}
