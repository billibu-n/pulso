// EL ARMAZON: los sitios de la ventana, y el orden en que se repliegan.
//
// LA NORMA QUE CUMPLE, y cada regla con su motivo (norma-app, AU-01 a AU-08):
//
//   AU-01  Al encoger, los sitios pierden EN ESTE ORDEN y el contenido es el ULTIMO:
//          1) el contenido  ·  2) el panel inferior  ·  3) el panel derecho  ·  4) el riel
//   AU-02  El riel, al perder su columna, se vuelve CAJON QUE SE ABRE -- no se oculta.
//          Un boton que no abre nada es PEOR que no tenerlo.
//   AU-03  En ventana estrecha, el cajon NACE CERRADO. Abrirlo por defecto TAPA el contenido.
//   AU-04  El contenido es el UNICO sitio que crece; los demas tienen limite declarado.
//   AU-05  Apilado, el armazon CRECE con su contenido y se desplaza la pagina.
//   AU-06  Todo sitio que se repliega deja forma de volver.
//   AU-07  Un sitio RESERVADO se declara; un hueco olvidado no se dibuja.
//
// Y HAY DOS REPARTOS, no uno, porque el cliente usa el MOVIL como dispositivo principal:
//   ESCRITORIO (>= 900 px): riel de 176 a la izquierda, panel de 320 a la derecha, franja abajo
//   MOVIL (< 900 px): navegacion ABAJO, sin riel -- porque en 411 dp el riel se comeria el 43 %
//
// LAS AREAS TOCABLES: 48 dp como minimo en el movil. **El dedo no es un raton.**

import { Claro, Oscuro } from "temas.slint";
// LOS ICONOS DE VERDAD. Existian 187 y la barra dibujaba cuadrados: el boceto dibujo un cuadrado
// como marcador y el marcador llego a produccion. Lo cazo el estudio del 2026-10-14.
import { Icono } from "iconos.slint";

// ---- Las medidas, declaradas una sola vez (AU-10: un valor vive en UN sitio) ----
export global Medidas {
    // ESTAS MEDIDAS SON LAS DEL DISENO APROBADO (`bocetos/generar-movil.py`), y NO se cambian
    // «para que quede mejor». Se cambiaron el 2026-10-13 -- margen de 16 a 18 y nav de 64 a 68 --
    // y el resultado fue que **la pantalla dejo de parecerse al diseno que el dueno aprobo**, sin
    // que nadie se enterara. **Si un valor del diseno no cuadra, se corrige el DISENO, y entonces
    // cambian los dos.** Hay una prueba que lo comprueba: `tests/medir-interfaz.rs`.

    // EL TAMANO DE LA VENTANA, declarado UNA vez (AU-67). La ventana no se redimensiona: es un
    // telefono de 411x880 dp. Antes estaba en dos sitios (aqui y en ventana.slint).
    out property <length> ancho: 411px;
    out property <length> alto: 880px;
    // El corte entre movil y escritorio, en pixeles logicos.
    out property <length> corte: 900px;
    out property <length> riel: 176px;
    out property <length> panel: 320px;
    // MEDIDAS DE ANDROID (Material 3), no del boceto: top app bar 64 y barra de navegacion 80.
    // El estudio y sus fuentes: docs/ESTUDIO-interfaz-android-2026-10-14.md.
    out property <length> cabecera: 64px;
    out property <length> nav_movil: 80px;
    // Las areas tocables, y son DOS medidas distintas a proposito.
    out property <length> toque_movil: 48px;   // el dedo
    out property <length> toque_raton: 32px;   // el puntero puede apuntar fino
    out property <length> margen: 16px;
    // 12 es el radio de tarjeta de Material 3 (antes 10, que era del boceto).
    out property <length> radio: 12px;
}

// ---- Una seccion del riel o de la navegacion ----
export struct Seccion {
    nombre: string,
    // El NOMBRE del icono de Lucide. Es DATO, no decoracion: la seccion dice con que icono se dibuja,
    // y asi el armazon no tiene una lista aparte que se desincronice (AU-10).
    icono: string,
    activa: bool,
}

// ---- EL ARMAZON DE ESCRITORIO ----
//
// POR QUE SON DOS COMPONENTES Y NO UNO CON UN `if`: en Slint, `@children` NO puede aparecer dentro de
// un elemento condicional. Se probo y no compila. Asi que el armazon se parte, y **la condicion va en
// la ventana**, que es quien sabe si es movil o no.
export component ArmazonEscritorio inherits Rectangle {
    in property <bool> oscuro: false;
    in property <[Seccion]> secciones;
    in property <string> titulo;
    callback elegir(int);

    // EL TAMANO DE LA VENTANA, no el que pida el contenido: al ocultar las tarjetas vacias el armazon
    // encogia y la barra de abajo SUBIA al centro. Se cazo midiendo, no mirando.
    width: Medidas.ancho;
    height: Medidas.alto;
    background: root.oscuro ? Oscuro.bg : Claro.bg;
    HorizontalLayout {
        // --- EL RIEL: limite declarado, no crece (AU-04) ---
        Rectangle {
            width: Medidas.riel;
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            VerticalLayout {
                padding-top: 20px;
                spacing: 4px;
                Text {
                    text: root.titulo;
                    font-size: 15px; font-weight: 700;
                    color: root.oscuro ? Oscuro.fg : Claro.fg;
                    x: 20px;
                }
                for s[i] in root.secciones : Rectangle {
                    height: 36px;
                    width: Medidas.riel - 20px;
                    x: 10px;
                    border-radius: 7px;
                    background: s.activa ? (root.oscuro ? Oscuro.ac : Claro.ac) : transparent;
                    Text {
                        text: s.nombre;
                        font-size: 13px;
                        color: s.activa ? (root.oscuro ? Oscuro.ac_txt : Claro.ac_txt)
                                        : (root.oscuro ? Oscuro.muted : Claro.muted);
                        x: 14px; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.elegir(i); } }
                }
            }
        }
        // --- EL CONTENIDO: el unico que crece (AU-04) ---
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            VerticalLayout {
                padding: Medidas.margen;
                // 14 y no 12: en el boceto las tarjetas respiran mas, y el apretado se nota.
                spacing: 14px;
                @children
            }
        }
    }
}

// ---- EL ARMAZON DE MOVIL ----
//
// Sin riel, y con la navegacion ABAJO. Por que: en 411 dp, un riel de 176 se comeria el 43 % del
// ancho. Eso no es un diseno, es un desperdicio.
export component ArmazonMovil inherits Rectangle {
    // Ids para MEDIR: la cabecera, el cuerpo del contenido y la barra de abajo.
    in property <bool> oscuro: false;
    in property <[Seccion]> secciones;
    in property <string> titulo;
    callback elegir(int);

    // EL TAMANO DE LA VENTANA (ver el otro armazon): mantiene la barra ABAJO aunque no haya datos.
    width: Medidas.ancho;
    height: Medidas.alto;
    background: root.oscuro ? Oscuro.bg : Claro.bg;
    VerticalLayout {
        // --- La cabecera: el cromo de arriba ---
        cabecera := Rectangle {
            // `accessible-id` es la forma OFICIAL de identificar un elemento para PRUEBAS y para
            // accesibilidad. Buscar por el nombre del componente (`ArmazonMovil::cabecera`) funciona,
            // pero **depende de como se llame por dentro**: si alguien lo renombra, la prueba se rompe
            // sin que nada este mal. Con esto, el nombre es **una decision, no una consecuencia**.
            //
            // Y EXIGE UN PAPEL, y Slint lo dice al compilar: "The `accessible-id` property can only be
            // set in combination to `accessible-role`". Los papeles de referencia -- `banner`, `main`,
            // `navigation`, `region`, `form` -- **identifican las zonas grandes de la pantalla**, y son
            // los que un lector de pantalla usa para saltar de una a otra.
            accessible-role: banner;
            accessible-id: "cabecera";
            height: Medidas.cabecera;
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            Text {
                text: root.titulo;
                // 22 px: title-large de Material 3 para el top app bar.
                font-size: 22px; font-weight: 700;
                color: root.oscuro ? Oscuro.fg : Claro.fg;
                x: Medidas.margen; vertical-alignment: center;
            }
        }
        // --- El contenido: apilado, y el armazon CRECE con el (AU-05) ---
        Rectangle {
            // `main`: la zona del trabajo. Con `banner` arriba y `navigation` abajo, la pantalla
            // queda **navegable por zonas** para quien use un lector de pantalla.
            accessible-role: main;
            accessible-id: "contenido";
            vertical-stretch: 1;
            // ALTURA MINIMA DECLARADA: es lo que mantiene la barra de abajo PEGADA ABAJO aunque el
            // contenido sea corto (estado sin datos). Medido: sin esto la barra subia al centro.
            min-height: Medidas.alto - Medidas.cabecera - Medidas.nav_movil;
            background: transparent;
            VerticalLayout {
                padding: Medidas.margen;
                // 14 y no 12: en el boceto las tarjetas respiran mas, y el apretado se nota.
                spacing: 14px;
                @children
            }
        }
        // --- La navegacion: el cromo de abajo ---
        nav := Rectangle {
            // `navigation`: el papel de referencia que corresponde a una barra de navegacion.
            accessible-role: navigation;
            accessible-id: "navegacion";
            height: Medidas.nav_movil;
            background: root.oscuro ? Oscuro.sup : Claro.sup;
            HorizontalLayout {
                // EL AIRE ENTRE ITEMS, y es lo que faltaba: sin esto los textos se PEGAN unos a
                // otros y sale «ResumenZonasSesionesDatos» -- que es lo que se vio en pantalla.
                spacing: 4px;
                padding-left: 4px;
                padding-right: 4px;
                for s[i] in root.secciones : Rectangle {
                    // REPARTIDA POR IGUAL, no al tamano del texto (AU-68).
                    width: parent.width / 4;
                    background: transparent;
                    // AREA TOCABLE de 48 dp como minimo: **el dedo no es un raton.**
                    TouchArea { clicked => { root.elegir(i); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        // EL INDICADOR DEL ACTIVO: una PILDE tras el icono, que es el patron de la
                        // barra de navegacion de Android (Material 3), NO la linea de 2 px de antes.
                        Rectangle {
                            width: 64px; height: 32px; border-radius: 16px;
                            background: s.activa
                                ? (root.oscuro ? Oscuro.ac : Claro.ac).with-alpha(0.18)
                                : transparent;
                            VerticalLayout {
                                alignment: center;
                                Icono {
                                    // 24 dp: el tamano del icono en la barra de Android.
                                    nombre: s.icono;
                                    tamano: 24px;
                                    tono: s.activa ? (root.oscuro ? Oscuro.ac : Claro.ac)
                                                   : (root.oscuro ? Oscuro.muted : Claro.muted);
                                }
                            }
                        }
                        Text {
                            text: s.nombre;
                            // 12 px: label-medium de Material 3 (antes 11).
                            font-size: 12px;
                            horizontal-alignment: center;
                            color: s.activa ? (root.oscuro ? Oscuro.ac : Claro.ac)
                                            : (root.oscuro ? Oscuro.muted : Claro.muted);
                        }
                    }
                }
            }
        }
    }
}
