// UN icono: el trazado, del color que se le diga, y del tamano que se le diga.
//
// Se dibuja con `Path` en un lienzo de 24x24 (el sistema de coordenadas de Lucide), y el
// tamano final lo pone `width` y `height`. Asi el mismo icono vale a 16 que a 48 sin tocar
// el trazado.
export component Icono inherits Path {
    in property <string> nombre: "casa";
    in property <length> tamano: 18px;
    in property <color> tono: black;

    width: root.tamano;
    height: root.tamano;
    viewbox-width: 24.0;
    viewbox-height: 24.0;
    fill: transparent;
    stroke: root.tono;
    stroke-width: 2px;
    clip: true;

    // El trazado, elegido por nombre. Es una cadena condicional: Slint no tiene
    // diccionarios, asi que esto es lo mas directo que hay.
